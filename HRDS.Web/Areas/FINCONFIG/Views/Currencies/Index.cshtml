@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.Currencies;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-cash-stack fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.Currencies</h4>
                    <p class="text-muted mb-0 small">@Resource.CurrenciesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewCurrency
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="currenciesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.CurrencyCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Symbol</th>
                            <th>@Resource.IsBaseCurrency</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="currencyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewCurrency</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="currencyForm">
                    <input type="hidden" id="currencyId" value="0" />

                    <div class="row mb-3 text-start">
                        <div class="col-md-6">
                            <label class="form-label text-white">@Resource.CurrencyCode <span class="text-danger">*</span></label>
                            <input type="text" id="currencyCode" class="form-control" placeholder="e.g. EGP" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white">@Resource.Symbol</label>
                            <input type="text" id="symbol" class="form-control" placeholder="e.g. ج.م or $" />
                        </div>
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="currencyNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="currencyNameEn" class="form-control" />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Description</label>
                        <textarea id="description" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="row mb-3 text-start">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isBaseCurrency">
                                <label class="form-check-label text-white ms-2" for="isBaseCurrency">@Resource.IsBaseCurrency</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveCurrency()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let currencyModal;

        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewCurrency)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditCurrency)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditCurrency)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            yes: @Html.Raw(Json.Serialize(Resource.Yes)),
            no: @Html.Raw(Json.Serialize(Resource.No)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            currencyModal = new bootstrap.Modal(document.getElementById('currencyModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#currenciesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "Currencies")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'currencyId', width: '5%' },
                    {
                        data: 'currencyCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'currencyNameAr' },
                    { data: 'currencyNameEn', render: data => data || '-' },
                    {
                        data: 'symbol',
                        render: function (data) {
                            return data ? `<span class="fw-bold text-info">${data}</span>` : '-';
                        }
                    },
                    {
                        data: 'isBaseCurrency',
                        render: function (data) {
                            return data ? `<span class="badge bg-success px-2 py-1">${localizedStrings.yes}</span>`
                                        : `<span class="badge bg-secondary px-2 py-1">${localizedStrings.no}</span>`;
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'currencyId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editCurrency(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#currencyId').val(0);
            $('#currencyForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#isBaseCurrency').prop('checked', false);
            $('#modalTitle').html(localizedStrings.addTitle);
            currencyModal.show();
        }

        function editCurrency(id) {
            $.get('@Url.Action("GetById", "Currencies")/' + id, function (data) {
                if (data) {
                    $('#currencyId').val(data.currencyId);
                    $('#currencyCode').val(data.currencyCode);
                    $('#currencyNameAr').val(data.currencyNameAr);
                    $('#currencyNameEn').val(data.currencyNameEn);
                    $('#symbol').val(data.symbol);
                    $('#description').val(data.description);
                    $('#isBaseCurrency').prop('checked', data.isBaseCurrency);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    currencyModal.show();
                }
            });
        }

        function saveCurrency() {
            let model = {
                CurrencyId: parseInt($('#currencyId').val()) || 0,
                CurrencyCode: $('#currencyCode').val(),
                CurrencyNameAr: $('#currencyNameAr').val(),
                CurrencyNameEn: $('#currencyNameEn').val(),
                Symbol: $('#symbol').val(),
                Description: $('#description').val(),
                IsBaseCurrency: $('#isBaseCurrency').is(':checked'),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.CurrencyCode || !model.CurrencyNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "Currencies")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        currencyModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}