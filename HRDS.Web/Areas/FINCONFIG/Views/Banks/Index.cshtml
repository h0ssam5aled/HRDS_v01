@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.Banks;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-bank fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.Banks</h4>
                    <p class="text-muted mb-0 small">@Resource.BanksDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewBank
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="banksTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.BankCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.SwiftCode</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bankModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewBank</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="bankForm">
                    <input type="hidden" id="bankId" value="0" />

                    <div class="row mb-3 text-start">
                        <div class="col-md-6">
                            <label class="form-label text-white">@Resource.BankCode <span class="text-danger">*</span></label>
                            <input type="text" id="bankCode" class="form-control" placeholder="e.g. CIB, NBE" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white">@Resource.SwiftCode</label>
                            <input type="text" id="swiftCode" class="form-control" placeholder="e.g. CIBEEGCX" />
                        </div>
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="bankNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="bankNameEn" class="form-control" />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Description</label>
                        <textarea id="description" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="form-check form-switch text-start">
                        <input class="form-check-input" type="checkbox" id="isActive" checked>
                        <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveBank()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let bankModal;

        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewBank)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditBank)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditBank)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            bankModal = new bootstrap.Modal(document.getElementById('bankModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#banksTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "Banks")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'bankId', width: '5%' },
                    {
                        data: 'bankCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'bankNameAr' },
                    { data: 'bankNameEn', render: data => data || '-' },
                    {
                        data: 'swiftCode',
                        render: function (data) {
                            return data ? `<span class="font-monospace text-info">${data}</span>` : '-';
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'bankId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editBank(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#bankId').val(0);
            $('#bankForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            bankModal.show();
        }

        function editBank(id) {
            $.get('@Url.Action("GetById", "Banks")/' + id, function (data) {
                if (data) {
                    $('#bankId').val(data.bankId);
                    $('#bankCode').val(data.bankCode);
                    $('#bankNameAr').val(data.bankNameAr);
                    $('#bankNameEn').val(data.bankNameEn);
                    $('#swiftCode').val(data.swiftCode);
                    $('#description').val(data.description);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    bankModal.show();
                }
            });
        }

        function saveBank() {
            let model = {
                BankId: parseInt($('#bankId').val()) || 0,
                BankCode: $('#bankCode').val(),
                BankNameAr: $('#bankNameAr').val(),
                BankNameEn: $('#bankNameEn').val(),
                SwiftCode: $('#swiftCode').val(),
                Description: $('#description').val(),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.BankCode || !model.BankNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "Banks")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        bankModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}