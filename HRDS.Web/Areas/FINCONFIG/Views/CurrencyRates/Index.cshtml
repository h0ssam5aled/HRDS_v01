@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.CurrencyRates;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-currency-exchange fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.CurrencyRates</h4>
                    <p class="text-muted mb-0 small">@Resource.CurrencyRatesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewCurrencyRate
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="currencyRatesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.Currency</th>
                            <th>@Resource.BaseCurrency</th>
                            <th>@Resource.ExchangeRate</th>
                            <th>@Resource.RateDate</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="currencyRateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewCurrencyRate</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="currencyRateForm">
                    <input type="hidden" id="currencyRateId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Currency <span class="text-danger">*</span></label>
                        <select id="currencyId" class="form-select" required></select>
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.BaseCurrency <span class="text-danger">*</span></label>
                        <select id="baseCurrencyId" class="form-select" required></select>
                    </div>

                    <div class="row mb-3 text-start">
                        <div class="col-md-6">
                            <label class="form-label text-white">@Resource.ExchangeRate <span class="text-danger">*</span></label>
                            <input type="number" step="0.0001" id="exchangeRate" class="form-control" placeholder="1.0000" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white">@Resource.RateDate <span class="text-danger">*</span></label>
                            <input type="date" id="rateDate" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-check form-switch text-start">
                        <input class="form-check-input" type="checkbox" id="isActive" checked>
                        <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveCurrencyRate()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let currencyRateModal;

        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewCurrencyRate)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditCurrencyRate)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditCurrencyRate)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            currencyRateModal = new bootstrap.Modal(document.getElementById('currencyRateModal'));
            loadCurrenciesDropdown();
            loadDataTable();
        });

        function loadCurrenciesDropdown() {
            $.get('@Url.Action("GetCurrenciesDropdown", "CurrencyRates")', function (data) {
                let ddlCur = $('#currencyId');
                let ddlBase = $('#baseCurrencyId');
                ddlCur.empty().append('<option value="">-- ' + @Html.Raw(Json.Serialize(Resource.SelectCurrency)) + ' --</option>');
                ddlBase.empty().append('<option value="">-- ' + @Html.Raw(Json.Serialize(Resource.SelectBaseCurrency)) + ' --</option>');

                $.each(data, function (i, item) {
                    ddlCur.append($('<option>', { value: item.id, text: item.name }));
                    ddlBase.append($('<option>', { value: item.id, text: item.name }));
                });
            });
        }

        function loadDataTable() {
            table = $('#currencyRatesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "CurrencyRates")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'currencyRateId', width: '5%' },
                    { data: 'currencyName' },
                    { data: 'baseCurrencyName' },
                    {
                        data: 'exchangeRate',
                        render: function (data) {
                            return `<span class="font-monospace text-info font-bold">${parseFloat(data).toFixed(4)}</span>`;
                        }
                    },
                    {
                        data: 'rateDate',
                        render: function (data) {
                            return `<span class="font-monospace">${data}</span>`;
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'currencyRateId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editCurrencyRate(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#currencyRateId').val(0);
            $('#currencyRateForm')[0].reset();

            let today = new Date().toISOString().split('T')[0];
            $('#rateDate').val(today);
            $('#isActive').prop('checked', true);

            $('#modalTitle').html(localizedStrings.addTitle);
            currencyRateModal.show();
        }

        function editCurrencyRate(id) {
            $.get('@Url.Action("GetById", "CurrencyRates")/' + id, function (data) {
                if (data) {
                    $('#currencyRateId').val(data.currencyRateId);
                    $('#currencyId').val(data.currencyId);
                    $('#baseCurrencyId').val(data.baseCurrencyId);
                    $('#exchangeRate').val(data.exchangeRate);
                    $('#rateDate').val(data.rateDate);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    currencyRateModal.show();
                }
            });
        }

        function saveCurrencyRate() {
            let model = {
                CurrencyRateId: parseInt($('#currencyRateId').val()) || 0,
                CurrencyId: parseInt($('#currencyId').val()) || 0,
                BaseCurrencyId: parseInt($('#baseCurrencyId').val()) || 0,
                ExchangeRate: parseFloat($('#exchangeRate').val()) || 0,
                RateDate: $('#rateDate').val(),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.CurrencyId || !model.BaseCurrencyId || !model.ExchangeRate || !model.RateDate) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "CurrencyRates")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        currencyRateModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}