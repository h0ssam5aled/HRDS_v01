@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.GendersManagement;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-gender-ambiguous fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.GendersManagement</h4>
                    <p class="text-muted mb-0 small">@Resource.ViewAddEditGender</p>
                </div>
            </div>
            <div>
                <button type="button" class="btn btn-add px-4 py-2" onclick="openAddModal()">
                    <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewGende
                </button>
            </div>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="gendersTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.CodeGender</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Order</th>
                            <th>@Resource.Status</th>
                            <th class="text-center">@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Form -->
<div class="modal fade" id="genderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewGende</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="genderForm">
                    <input type="hidden" id="genderId" value="0" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small">@Resource.CodeGender</label>
                            <input type="text" id="genderCode" class="form-control" maxlength="20" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@Resource.Order</label>
                            <input type="number" id="sortOrder" class="form-control" value="1" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">@Resource.ArabicName</label>
                            <input type="text" id="genderNameAr" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">@Resource.EnglishName</label>
                            <input type="text" id="genderNameEn" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch d-flex align-items-center gap-2 mt-2">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label text-white" for="isActive">@Resource.Status</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-add px-4" onclick="saveGender()">@Resource.SaveData</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;

        $.fn.dataTable.ext.pager.three_numbers = function (page, pages) {
            let numbers = [];
            let buttons = 3;
            let half = Math.floor(buttons / 2);

            let start = page - half;
            let end = page + half;

            if (start < 0) {
                start = 0;
                end = Math.min(pages, buttons);
            } else if (end > pages) {
                end = pages;
                start = Math.max(0, pages - buttons);
            }

            for (let i = start; i < end; i++) {
                numbers.push(i);
            }

            return ['previous', numbers, 'next'];
        };

        $(document).ready(function () {
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#gendersTable').DataTable({
               pagingType: 'simple',
                pageLength: 10,
                ajax: {
                    url: '@Url.Action("GetGendersJson", "Genders", new { area = "Config" })',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'genderId', width: '5%' },
                    {
                        data: 'genderCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data}</span>`;
                        }
                    },
                    { data: 'genderNameAr' },
                    { data: 'genderNameEn' },
                    { data: 'sortOrder' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data
                                ? `<span class="badge neon-badge-active px-2 py-1"><i class="bi bi-check-circle me-1"></i>@Resource.Active</span>`
                                : `<span class="badge neon-badge-inactive px-2 py-1"><i class="bi bi-x-circle me-1"></i>@Resource.Inactive</span>`;
                        }
                    },
                    {
                        data: 'genderId',
                        className: 'text-center',
                        render: function (data) {
                            return `<button onclick="openEditModal(${data})" class="btn btn-sm btn-edit px-3">
                                        <i class="bi bi-pencil-square me-1"></i> @Resource.EditGende
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#genderId').val(0);
            $('#genderCode').val('');
            $('#genderNameAr').val('');
            $('#genderNameEn').val('');
            $('#sortOrder').val(1);
            $('#isActive').prop('checked', true);

            $('#modalTitle').text('@Html.Raw(Resource.AddNewGende)');
            $('#genderModal').modal('show');
        }

        function openEditModal(id) {
            $.get(`@Url.Action("GetById", "Genders", new { area = "Config" })/${id}`, function (res) {
                if (res.success) {
                    let d = res.data;
                    $('#genderId').val(d.genderId);
                    $('#genderCode').val(d.genderCode);
                    $('#genderNameAr').val(d.genderNameAr);
                    $('#genderNameEn').val(d.genderNameEn);
                    $('#sortOrder').val(d.sortOrder);
                    $('#isActive').prop('checked', d.isActive);

                    $('#modalTitle').text('@Html.Raw(Resource.EditGende)');
                    $('#genderModal').modal('show');
                } else {
                    alert(res.message);
                }
            });
        }

        function saveGender() {
            let model = {
                genderId: parseInt($('#genderId').val()),
                genderCode: $('#genderCode').val(),
                genderNameAr: $('#genderNameAr').val(),
                genderNameEn: $('#genderNameEn').val(),
                sortOrder: parseInt($('#sortOrder').val()),
                isActive: $('#isActive').is(':checked')
            };

            $.ajax({
                url: '@Url.Action("Save", "Genders", new { area = "Config" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function (res) {
                    if (res.success) {
                        $('#genderModal').modal('hide');
                        table.ajax.reload();
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert('حدث خطأ أثناء الاتصال بالسيرفر.');
                }
            });
        }
    </script>
}