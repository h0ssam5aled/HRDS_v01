@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.CitiesManagement;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-geo-alt fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.CitiesManagement</h4>
                    <p class="text-muted mb-0 small">@Resource.ViewAddEditCities</p>
                </div>
            </div>
            <div>
                <button type="button" class="btn btn-add px-4 py-2" onclick="openAddModal()">
                    <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewCity
                </button>
            </div>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="citiesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.Governorate</th>
                            <th>@Resource.CityCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Order</th>
                            <th>@Resource.Status</th>
                            <th class="text-center">@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal City Form -->
<div class="modal fade" id="cityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewCity</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="cityForm">
                    <input type="hidden" id="cityId" value="0" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small">@Resource.Governorate</label>
                            <select id="governorateId" class="form-select" required>
                                <option value="">-- @Resource.SelectGovernorate --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@Resource.CityCode</label>
                            <input type="text" id="cityCode" class="form-control" maxlength="20" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">@Resource.Order</label>
                            <input type="number" id="sortOrder" class="form-control" value="1" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">@Resource.ArabicName</label>
                            <input type="text" id="cityNameAr" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small">@Resource.EnglishName</label>
                            <input type="text" id="cityNameEn" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch d-flex align-items-center gap-2 mt-2">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label text-white" for="isActive">@Resource.Status</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-add px-4" onclick="saveCity()">@Resource.SaveData</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;

        $.fn.dataTable.ext.pager.three_numbers = function (page, pages) {
            let numbers = [];
            let buttons = 3;
            let half = Math.floor(buttons / 2);

            let start = page - half;
            let end = page + half;

            if (start < 0) {
                start = 0;
                end = Math.min(pages, buttons);
            } else if (end > pages) {
                end = pages;
                start = Math.max(0, pages - buttons);
            }

            for (let i = start; i < end; i++) {
                numbers.push(i);
            }

            return ['previous', numbers, 'next'];
        };

        $(document).ready(function () {
            loadGovernoratesLookup();
            loadDataTable();
        });

        function loadGovernoratesLookup() {
            $.get('@Url.Action("GetGovernoratesLookup", "Cities", new { area = "Config" })', function (res) {
                if (res.success) {
                    let ddl = $('#governorateId');
                    ddl.empty();
                    ddl.append(`<option value="">-- @Html.Raw(Resource.SelectGovernorate) --</option>`);
                    $.each(res.data, function (i, item) {
                        let name = '@currentCulture' === 'ar' ? item.governorateNameAr : item.governorateNameEn;
                        ddl.append(`<option value="${item.governorateId}">${name}</option>`);
                    });
                }
            });
        }

        function loadDataTable() {
            table = $('#citiesTable').DataTable({
                 pagingType: 'simple',
                pageLength: 10,
                ajax: {
                    url: '@Url.Action("GetCitiesJson", "Cities", new { area = "Config" })',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'cityId', width: '5%' },
                    {
                        data: '@(currentCulture == "ar" ? "governorateNameAr" : "governorateNameEn")',
                        render: function (data) {
                            return `<span class="fw-semibold text-info">${data || ''}</span>`;
                        }
                    },
                    {
                        data: 'cityCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data}</span>`;
                        }
                    },
                    { data: 'cityNameAr' },
                    { data: 'cityNameEn' },
                    { data: 'sortOrder' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data
                                ? `<span class="badge neon-badge-active px-2 py-1"><i class="bi bi-check-circle me-1"></i>@Resource.Active</span>`
                                : `<span class="badge neon-badge-inactive px-2 py-1"><i class="bi bi-x-circle me-1"></i>@Resource.Inactive</span>`;
                        }
                    },
                    {
                        data: 'cityId',
                        className: 'text-center',
                        render: function (data) {
                            return `<button onclick="openEditModal(${data})" class="btn btn-sm btn-edit px-3">
                                        <i class="bi bi-pencil-square me-1"></i> @Resource.EditCity
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#cityId').val(0);
            $('#governorateId').val('');
            $('#cityCode').val('');
            $('#cityNameAr').val('');
            $('#cityNameEn').val('');
            $('#sortOrder').val(1);
            $('#isActive').prop('checked', true);

            $('#modalTitle').text('@Html.Raw(Resource.AddNewCity)');
            $('#cityModal').modal('show');
        }

        function openEditModal(id) {
            $.get(`@Url.Action("GetById", "Cities", new { area = "Config" })/${id}`, function (res) {
                if (res.success) {
                    let d = res.data;
                    $('#cityId').val(d.cityId);
                    $('#governorateId').val(d.governorateId);
                    $('#cityCode').val(d.cityCode);
                    $('#cityNameAr').val(d.cityNameAr);
                    $('#cityNameEn').val(d.cityNameEn);
                    $('#sortOrder').val(d.sortOrder);
                    $('#isActive').prop('checked', d.isActive);

                    $('#modalTitle').text('@Html.Raw(Resource.EditCity)');
                    $('#cityModal').modal('show');
                } else {
                    alert(res.message);
                }
            });
        }

        function saveCity() {
            let model = {
                cityId: parseInt($('#cityId').val()),
                governorateId: parseInt($('#governorateId').val()),
                cityCode: $('#cityCode').val(),
                cityNameAr: $('#cityNameAr').val(),
                cityNameEn: $('#cityNameEn').val(),
                sortOrder: parseInt($('#sortOrder').val()),
                isActive: $('#isActive').is(':checked')
            };

            if (!model.governorateId) {
                alert('@Resource.PleaseSelectGovernorate');
                return;
            }

            $.ajax({
                url: '@Url.Action("Save", "Cities", new { area = "Config" })',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function (res) {
                    if (res.success) {
                        $('#cityModal').modal('hide');
                        table.ajax.reload();
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert('حدث خطأ أثناء الاتصال بالسيرفر.');
                }
            });
        }
    </script>
}