@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.UsersOverview;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-people-fill fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.UserManagement</h4>
                    <p class="text-muted mb-0 small">@Resource.AccountsAndAssignedRolesOverview</p>
                </div>
            </div>

            <a asp-action="Create" class="btn btn-neon-add px-3 py-2 d-flex align-items-center gap-2">
                <i class="bi bi-person-plus-fill fs-5"></i>
                <span>@Resource.AddNewUser</span>
            </a>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="usersTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.Username</th>
                            <th>@Resource.EmailAddress</th>
                            <th>@Resource.Roles</th>
                            <th>@Resource.Status</th>
                            <th style="width: 15%;">@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;

        $(document).ready(function () {
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#usersTable').DataTable({
                pagingType: 'simple',
                pageLength: 10,
                ajax: {
                    url: '@Url.Action("GetUsersJson", "Users")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'userId', width: '5%' },
                    {
                        data: 'username',
                        render: function (data) {
                            return `<span class="badge dark-badge-user font-monospace px-2 py-1"><i class="bi bi-person me-1"></i>${data}</span>`;
                        }
                    },
                    {
                        data: 'email',
                        render: function(data) {
                            return data ? data : '<span class="text-muted small">غير محدد</span>';
                        }
                    },
                    {
                        data: 'roles',
                        render: function (data) {
                            return data
                                ? `<span class="badge dark-badge-role px-2 py-1"><i class="bi bi-shield-lock me-1"></i>${data}</span>`
                                : '<span class="text-muted small">بدون دور</span>';
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data
                                ? `<span class="badge neon-badge-active px-2 py-1"><i class="bi bi-check-circle me-1"></i>@Resource.Active</span>`
                                : `<span class="badge neon-badge-inactive px-2 py-1"><i class="bi bi-x-circle me-1"></i>@Resource.Inactive</span>`;
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            var editUrl = '@Url.Action("Edit", "Users")/' + row.userId;

                            var statusBtnClass = row.isActive ? 'btn-outline-warning' : 'btn-outline-success';
                            var statusBtnIcon = row.isActive ? 'bi-power' : 'bi-check2-circle';
                            var statusBtnTitle = row.isActive ? 'إيقاف الحساب' : 'تفعيل الحساب';

                            return `<div class="d-flex align-items-center gap-2">
                                        <a href="${editUrl}" class="btn btn-sm btn-outline-info rounded-2" title="تعديل">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" onclick="toggleUserStatus(${row.userId}, ${row.isActive})"
                                                class="btn btn-sm ${statusBtnClass} btn-status-toggle rounded-2" title="${statusBtnTitle}">
                                            <i class="bi ${statusBtnIcon}"></i>
                                        </button>
                                    </div>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        // دالة تغيير حالة المستخدم باستخدام AJAX
        function toggleUserStatus(userId, currentStatus) {
            let actionText = currentStatus ? "إيقاف" : "تفعيل";

            if (confirm(`هل أنت تأكد من رغبتك في ${actionText} هذا الحساب؟`)) {
                $.ajax({
                    url: '@Url.Action("ToggleStatus", "Users")',
                    type: 'POST',
                    data: { id: userId },
                    success: function (response) {
                        if (response.success) {
                            table.ajax.reload(null, false);
                        } else {
                            alert(response.message || 'حدث خطأ أثناء تنفيذ العملية.');
                        }
                    },
                    error: function () {
                        alert('حدث خطأ في الاتصال بالسيرفر.');
                    }
                });
            }
        }
    </script>
}