@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.UsersOverview;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

<style>
    .card.dark-card, .dark-card {
        background-color: #0f172a !important;
        border: 1px solid #1e293b !important;
        color: #ffffff !important;
        border-radius: 10px;
    }

        .dark-card h4, .dark-card p, .dark-card div {
            color: #ffffff !important;
        }

            .dark-card p.text-muted {
                color: #94a3b8 !important;
            }

    .card-body, .table-responsive, table.dataTable, table.dataTable * {
        background-color: transparent !important;
    }

        table.dataTable thead th {
            background-color: #1e293b !important;
            color: #38bdf8 !important;
            border-bottom: 2px solid #334155 !important;
            padding: 14px 16px !important;
            font-size: 0.95rem;
            font-weight: 700;
            text-align: start !important;
        }

        table.dataTable tbody tr td {
            color: #ffffff !important;
            padding: 14px 16px !important;
            vertical-align: middle;
            border-bottom: 1px solid #1e293b !important;
            transition: all 0.2s ease-in-out;
            text-align: start !important;
        }

        table.dataTable tbody tr:hover td {
            color: #00ff66 !important;
            text-shadow: 0 0 8px rgba(0, 255, 102, 0.7);
            background-color: rgba(0, 255, 102, 0.04) !important;
        }

    .dataTables_wrapper .row:first-child, .dataTables_wrapper > div:first-child {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        flex-wrap: wrap !important;
        margin-bottom: 1rem !important;
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        color: #ffffff !important;
        font-weight: 500;
        float: none !important;
        width: auto !important;
        margin: 0 !important;
        padding: 0 !important;
    }

        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dataTables_length select {
            background-color: #1e293b !important;
            border: 1px solid #334155 !important;
            color: #ffffff !important;
            border-radius: 6px;
            padding: 6px 12px;
            outline: none;
        }

            .dataTables_wrapper .dataTables_filter input:focus {
                border-color: #00ff66 !important;
                box-shadow: 0 0 8px rgba(0, 255, 102, 0.4);
            }

    [dir="ltr"] .dataTables_wrapper .dataTables_length {
        order: 1 !important;
        text-align: left !important;
    }

    [dir="ltr"] .dataTables_wrapper .dataTables_filter {
        order: 2 !important;
        text-align: right !important;
    }

        [dir="ltr"] .dataTables_wrapper .dataTables_filter input {
            margin-left: 0.5em !important;
            margin-right: 0 !important;
        }

    [dir="rtl"] .dataTables_wrapper .dataTables_length {
        order: 1 !important;
        text-align: right !important;
    }

    [dir="rtl"] .dataTables_wrapper .dataTables_filter {
        order: 2 !important;
        text-align: left !important;
    }

        [dir="rtl"] .dataTables_wrapper .dataTables_filter input {
            margin-right: 0.5em !important;
            margin-left: 0 !important;
        }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        background: #1e293b !important;
        border: 1px solid #334155 !important;
        color: #ffffff !important;
        border-radius: 6px !important;
        margin: 0 2px;
    }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current,
        .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
            background: #2563eb !important;
            border-color: #2563eb !important;
            color: #ffffff !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: #334155 !important;
            color: #00ff66 !important;
        }

    .neon-badge-active {
        background-color: rgba(0, 212, 255, 0.12) !important;
        color: #00d4ff !important;
        border: 1px solid #00d4ff !important;
        font-weight: 600;
        text-shadow: 0 0 6px rgba(0, 212, 255, 0.8);
        box-shadow: 0 0 8px rgba(0, 212, 255, 0.3);
    }

    .neon-badge-inactive {
        background-color: rgba(255, 42, 109, 0.12) !important;
        color: #ff2a6d !important;
        border: 1px solid #ff2a6d !important;
        font-weight: 600;
        text-shadow: 0 0 6px rgba(255, 42, 109, 0.8);
        box-shadow: 0 0 8px rgba(255, 42, 109, 0.3);
    }

    .dark-badge-role {
        background-color: rgba(168, 85, 247, 0.15) !important;
        color: #c084fc !important;
        border: 1px solid #a855f7 !important;
        font-weight: 600;
    }

    .dark-badge-user {
        background-color: #1e293b !important;
        color: #38bdf8 !important;
        border: 1px solid #334155 !important;
    }

    .btn-neon-add {
        background-color: rgba(0, 255, 102, 0.12) !important;
        color: #00ff66 !important;
        border: 1px solid #00ff66 !important;
        font-weight: 600;
        transition: all 0.2s ease-in-out;
        box-shadow: 0 0 8px rgba(0, 255, 102, 0.2);
    }

        .btn-neon-add:hover {
            background-color: #00ff66 !important;
            color: #0f172a !important;
            box-shadow: 0 0 12px rgba(0, 255, 102, 0.6);
        }

    /* أزرار التفعيل والتعطيل */
    .btn-status-toggle {
        padding: 4px 8px;
        font-size: 0.85rem;
        transition: all 0.2s ease-in-out;
    }
</style>

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-people-fill fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.UserManagement</h4>
                    <p class="text-muted mb-0 small">@Resource.AccountsAndAssignedRolesOverview</p>
                </div>
            </div>

            <a asp-action="Create" class="btn btn-neon-add px-3 py-2 d-flex align-items-center gap-2">
                <i class="bi bi-person-plus-fill fs-5"></i>
                <span>@Resource.AddNewUser</span>
            </a>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="usersTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.Username</th>
                            <th>@Resource.EmailAddress</th>
                            <th>@Resource.Roles</th>
                            <th>@Resource.Status</th>
                            <th style="width: 15%;">@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;

        $.fn.dataTable.ext.pager.three_numbers = function (page, pages) {
            let numbers = [];
            let buttons = 3;
            let half = Math.floor(buttons / 2);

            let start = page - half;
            let end = page + half;

            if (start < 0) {
                start = 0;
                end = Math.min(pages, buttons);
            } else if (end > pages) {
                end = pages;
                start = Math.max(0, pages - buttons);
            }

            for (let i = start; i < end; i++) {
                numbers.push(i);
            }

            return ['previous', numbers, 'next'];
        };

        $(document).ready(function () {
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#usersTable').DataTable({
                pagingType: 'three_numbers',
                pageLength: 10,
                ajax: {
                    url: '@Url.Action("GetUsersJson", "Users")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'userId', width: '5%' },
                    {
                        data: 'username',
                        render: function (data) {
                            return `<span class="badge dark-badge-user font-monospace px-2 py-1"><i class="bi bi-person me-1"></i>${data}</span>`;
                        }
                    },
                    {
                        data: 'email',
                        render: function(data) {
                            return data ? data : '<span class="text-muted small">غير محدد</span>';
                        }
                    },
                    {
                        data: 'roles',
                        render: function (data) {
                            return data
                                ? `<span class="badge dark-badge-role px-2 py-1"><i class="bi bi-shield-lock me-1"></i>${data}</span>`
                                : '<span class="text-muted small">بدون دور</span>';
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data
                                ? `<span class="badge neon-badge-active px-2 py-1"><i class="bi bi-check-circle me-1"></i>@Resource.Active</span>`
                                : `<span class="badge neon-badge-inactive px-2 py-1"><i class="bi bi-x-circle me-1"></i>@Resource.Inactive</span>`;
                        }
                    },
                    {
                        data: null,
                        render: function (data, type, row) {
                            var editUrl = '@Url.Action("Edit", "Users")/' + row.userId;

                            var statusBtnClass = row.isActive ? 'btn-outline-warning' : 'btn-outline-success';
                            var statusBtnIcon = row.isActive ? 'bi-power' : 'bi-check2-circle';
                            var statusBtnTitle = row.isActive ? 'إيقاف الحساب' : 'تفعيل الحساب';

                            return `<div class="d-flex align-items-center gap-2">
                                        <a href="${editUrl}" class="btn btn-sm btn-outline-info rounded-2" title="تعديل">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button type="button" onclick="toggleUserStatus(${row.userId}, ${row.isActive})"
                                                class="btn btn-sm ${statusBtnClass} btn-status-toggle rounded-2" title="${statusBtnTitle}">
                                            <i class="bi ${statusBtnIcon}"></i>
                                        </button>
                                    </div>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        // دالة تغيير حالة المستخدم باستخدام AJAX
        function toggleUserStatus(userId, currentStatus) {
            let actionText = currentStatus ? "إيقاف" : "تفعيل";

            if (confirm(`هل أنت تأكد من رغبتك في ${actionText} هذا الحساب؟`)) {
                $.ajax({
                    url: '@Url.Action("ToggleStatus", "Users")',
                    type: 'POST',
                    data: { id: userId },
                    success: function (response) {
                        if (response.success) {
                            // إعادة تحميل الجدول بدون عمل Reload للصفحة كلها
                            table.ajax.reload(null, false);
                        } else {
                            alert(response.message || 'حدث خطأ أثناء تنفيذ العملية.');
                        }
                    },
                    error: function () {
                        alert('حدث خطأ في الاتصال بالسيرفر.');
                    }
                });
            }
        }
    </script>
}