<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Header Card -->
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-shield-shaded fs-2 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">مصفوفة صلاحيات الدور: <span class="text-info">@Model.RoleNameAr</span></h4>
                    <p class="text-muted mb-0 small">حدد الصلاحيات المطلوبة المتاحة لكل شاشة وموديول</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="/Security/Roles" class="btn btn-outline-secondary btn-sm px-3 align-self-center">
                    <i class="bi bi-arrow-right me-1"></i> عودة للأدوار
                </a>
                <button type="button" id="btnSavePermissions" class="btn btn-save-matrix px-4">
                    <i class="bi bi-check-lg me-1"></i> حفظ الصلاحيات
                </button>
            </div>
        </div>
    </div>

    <!-- Modules Matrix List -->
    <form id="matrixForm">
        <input type="hidden" id="RoleId" value="@Model.RoleId" />

        <div class="accordion" id="modulesAccordion">
            @foreach (var module in Model.Modules)
            {
                <div class="accordion-item dark-accordion">
                    <h2 class="accordion-header" id="heading-@module.ModuleId">
                        <button class="accordion-button dark-accordion-btn collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@module.ModuleId">
                            <i class="bi bi-folder2-open me-2"></i> @module.ModuleNameAr
                        </button>
                    </h2>
                    <div id="collapse-@module.ModuleId" class="accordion-collapse collapse" data-bs-parent="#modulesAccordion">
                        <div class="accordion-body p-0">
                            <div class="table-responsive">
                                <table class="table matrix-table align-middle m-0">
                                    <thead>
                                        <tr>
                                            <th style="width: 25%;">الشاشة (Model)</th>
                                            <th>العمليات والصلاحيات المتاحة (Actions)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var sysModel in module.Models)
                                        {
                                            <tr>
                                                <td class="model-title px-3">
                                                    <i class="bi bi-window me-2 text-info"></i>@sysModel.ModelNameAr
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-wrap gap-2 py-1">
                                                        @foreach (var act in sysModel.Actions)
                                                        {
                                                            <div class="perm-item d-flex align-items-center">
                                                                <input class="form-check-input neon-check perm-checkbox me-2"
                                                                       type="checkbox"
                                                                       value="@act.PermissionId"
                                                                       id="perm-@act.PermissionId"
                                                                       @(act.IsGranted ? "checked" : "") />
                                                                <label class="form-check-label perm-label mb-0" for="perm-@act.PermissionId">
                                                                    @act.ActionNameAr
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#btnSavePermissions').click(function () {
                let selectedIds = [];
                $('.perm-checkbox:checked').each(function () {
                    selectedIds.push(parseInt($(this).val()));
                });

                let requestData = {
                    roleId: parseInt($('#RoleId').val()),
                    selectedPermissionIds: selectedIds
                };

                $.ajax({
                    url: '/Security/RolePermissions/SavePermissions',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function (response) {
                        if (response.success) {
                            alert('تم حفظ الصلاحيات بنجاح!');
                        } else {
                            alert('حدث خطأ: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('حدث خطأ أثناء الاتصال بالسيرفر.');
                    }
                });
            });
        });
    </script>
}