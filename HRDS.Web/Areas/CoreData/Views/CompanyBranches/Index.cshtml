@model IEnumerable<HRDS.Web.Models.Entities.CompanyBranch>

@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = isArabic ? "فروع الشركات" : "Company Branches";
    var currentDir = isArabic ? "rtl" : "ltr";
}

<style>
    /* Card & Table Base */
    .dark-card {
        background-color: #0f172a !important;
        border: 1px solid #1e293b !important;
        color: #ffffff !important;
        border-radius: 10px;
    }

    .table-dark-custom {
        color: #cbd5e1 !important;
        background-color: #0f172a !important;
        border-color: #1e293b !important;
    }

        .table-dark-custom th {
            background-color: #1e293b !important;
            color: #38bdf8 !important;
            border-bottom: 2px solid #334155 !important;
            font-weight: 600;
        }

        .table-dark-custom td {
            background-color: #0f172a !important;
            color: #cbd5e1 !important;
            border-bottom: 1px solid #1e293b !important;
            vertical-align: middle;
        }

            /* إصلاح صف No Data Available */
            .table-dark-custom td.dataTables_empty {
                background-color: #0f172a !important;
                color: #64748b !important;
                font-weight: 500;
                padding: 20px !important;
            }

    /* DataTables Controls (Search & Length) */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_processing,
    .dataTables_wrapper .dataTables_paginate {
        color: #94a3b8 !important;
        margin-bottom: 12px;
    }

        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dataTables_length select {
            background-color: #1e293b !important;
            border: 1px solid #334155 !important;
            color: #ffffff !important;
            border-radius: 6px;
            padding: 4px 8px;
            outline: none;
        }

            .dataTables_wrapper .dataTables_filter input:focus,
            .dataTables_wrapper .dataTables_length select:focus {
                border-color: #38bdf8 !important;
                box-shadow: 0 0 5px rgba(56, 189, 248, 0.4);
            }

        /* Pagination Buttons */
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            color: #94a3b8 !important;
            background: #1e293b !important;
            border: 1px solid #334155 !important;
            border-radius: 6px !important;
            margin: 0 2px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current,
            .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
                background: #38bdf8 !important;
                color: #0f172a !important;
                font-weight: bold;
                border-color: #38bdf8 !important;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                background: #334155 !important;
                color: #ffffff !important;
                border-color: #475569 !important;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
            .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
                background: #0f172a !important;
                color: #475569 !important;
                border-color: #1e293b !important;
            }

    /* Buttons & Subtitles */
    .btn-neon-add {
        background-color: #38bdf8 !important;
        color: #0f172a !important;
        font-weight: bold;
        border: none;
        box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
    }

        .btn-neon-add:hover {
            background-color: #0284c7 !important;
            color: #ffffff !important;
        }

    .text-subtitle-dark {
        color: #94a3b8 !important;
    }
</style>

<div class="container-fluid py-3" dir="@currentDir">
    <!-- Header -->
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between py-3">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-diagram-3-fill fs-3 text-info"></i>
                <div>
                    <h4 class="mb-0 fw-bold">@(isArabic ? "فروع الشركات" : "Company Branches")</h4>
                    <p class="text-subtitle-dark mb-0 small">@(isArabic ? "إدارة فروع الشركات المسجلة بالنظام" : "Manage company branches registered in the system")</p>
                </div>
            </div>
            <a asp-action="Create" class="btn btn-neon-add px-3">
                <i class="bi bi-plus-lg me-1"></i> @(isArabic ? "إضافة فرع جديد" : "Add New Branch")
            </a>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card dark-card shadow-sm">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table id="branchesTable" class="table table-dark-custom table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>@(isArabic ? "كود الفرع" : "Code")</th>
                            <th>@(isArabic ? "اسم الفرع" : "Branch Name")</th>
                            <th>@(isArabic ? "الشركة" : "Company")</th>
                            <th>@(isArabic ? "الدولة / المحافظة" : "Country / Governorate")</th>
                            <th>@(isArabic ? "المدينة" : "City")</th>
                            <th>@(isArabic ? "نوع الفرع" : "Branch Type")</th>
                            <th>@(isArabic ? "الحالة" : "Status")</th>
                            <th class="text-center">@(isArabic ? "العمليات" : "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-info">@item.BranchCode</td>
                                <td>@(isArabic? item.BranchNameAr: item.BranchNameEn)</td>
                                <td>@(isArabic? item.Company?.CompanyNameAr : item.Company?.CompanyNameEn)</td>
                                <td>
                                    @(isArabic? item.Governorate?.Country?.CountryNameAr : item.Governorate?.Country?.CountryNameEn) -
                                    @(isArabic? item.Governorate?.GovernorateNameAr : item.Governorate?.GovernorateNameEn)
                                </td>
                                <td>@(isArabic? item.City?.CityNameAr : item.City?.CityNameEn)</td>
                                <td>
                                    @if (item.IsMainBranch)
                                    {
                                        <span class="badge bg-primary">@(isArabic ? "فرع رئيسي" : "Main Branch")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@(isArabic ? "فرع فرعي" : "Sub Branch")</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">@(isArabic ? "نشط" : "Active")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger">@(isArabic ? "غير نشط" : "Inactive")</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.CompanyBranchId" class="btn btn-sm btn-outline-info me-1" title="@(isArabic ? "تعديل" : "Edit")">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#branchesTable').DataTable({
                "language": {
                    "url": "@(isArabic ? "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json" : "")"
                },
                "pageLength": 10,
                "responsive": true
            });
        });
    </script>
}