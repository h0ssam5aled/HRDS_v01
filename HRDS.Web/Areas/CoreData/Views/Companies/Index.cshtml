@model IEnumerable<HRDS.Web.Models.Entities.Company>
@using HRDS.Web.Resources

@{
    ViewData["Title"] = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar" ? "إدارة الشركات" : "Manage Companies";
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "ar";
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var currentDir = isArabic ? "rtl" : "ltr";
}

<div class="container-fluid py-3" dir="@currentDir">
    <!-- Header Card -->
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-building fs-3 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@(isArabic ? "قائمة الشركات" : "Companies List")</h4>
                    <p class="text-slate-400 mb-0 small" style="color: #94a3b8 !important;">@(isArabic ? "إدارة الشركات المسجلة في النظام" : "Manage registered companies in the system")</p>
                </div>
            </div>
            <a asp-action="Create" class="btn btn-neon-add btn-sm px-3 py-2">
                <i class="bi bi-plus-lg me-1"></i> @(isArabic ? "إضافة شركة جديدة" : "Add Company")
            </a>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="companiesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>@(isArabic ? "كود الشركة" : "Code")</th>
                            <th>@(isArabic ? "اسم الشركة" : "Company Name")</th>
                            <th>@(isArabic ? "الرقم الضريبي" : "Tax Number")</th>
                            <th>@(isArabic ? "الهاتف" : "Phone")</th>
                            <th class="text-center">@(isArabic ? "الحالة" : "Status")</th>
                            <th class="text-center">@(isArabic ? "العمليات" : "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge dark-badge-code font-monospace px-2 py-1">@item.CompanyCode</span>
                                    </td>
                                    <td class="fw-semibold">@(isArabic? item.CompanyNameAr: item.CompanyNameEn)</td>
                                    <td>@(string.IsNullOrEmpty(item.TaxNumber) ? "-" : item.TaxNumber)</td>
                                    <td>@(string.IsNullOrEmpty(item.Phone) ? "-" : item.Phone)</td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge neon-badge-active px-2 py-1">
                                                <i class="bi bi-check-circle me-1"></i>@(isArabic ? "نشط" : "Active")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge neon-badge-inactive px-2 py-1">
                                                <i class="bi bi-x-circle me-1"></i>@(isArabic ? "غير نشط" : "Inactive")
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.CompanyId" class="btn btn-sm btn-action-edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // إعداد نمط ترقيم DataTables المخصص
        $.fn.dataTable.ext.pager.three_numbers = function (page, pages) {
            let numbers = [];
            let buttons = 3;
            let half = Math.floor(buttons / 2);

            let start = page - half;
            let end = page + half;

            if (start < 0) {
                start = 0;
                end = Math.min(pages, buttons);
            } else if (end > pages) {
                end = pages;
                start = Math.max(0, pages - buttons);
            }

            for (let i = start; i < end; i++) {
                numbers.push(i);
            }

            return ['previous', numbers, 'next'];
        };

        $(document).ready(function () {
            $('#companiesTable').DataTable({
                pagingType: 'simple',
                pageLength: 10,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        });
    </script>
}