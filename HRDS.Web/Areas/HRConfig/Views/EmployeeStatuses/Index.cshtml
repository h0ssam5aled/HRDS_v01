@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.EmployeeStatus;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Header Card -->
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-person-check fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.EmployeeStatus</h4>
                    <p class="text-muted mb-0 small">@Resource.EmployeeStatusDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewEmployeeStatus
            </button>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="employeeStatusTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.EmployeeStatusCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Description</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal الإضافة والتعديل -->
<div class="modal fade" id="employeeStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewEmployeeStatus</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="employeeStatusForm">
                    <input type="hidden" id="employeeStatusId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EmployeeStatusCode <span class="text-danger">*</span></label>
                        <input type="text" id="employeeStatusCode" class="form-control" placeholder="e.g. ACTIVE" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="employeeStatusNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="employeeStatusNameEn" class="form-control" />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Description</label>
                        <textarea id="description" class="form-control" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveEmployeeStatus()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let employeeStatusModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewEmployeeStatus)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditEmployeeStatus)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditEmployeeStatus)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            employeeStatusModal = new bootstrap.Modal(document.getElementById('employeeStatusModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#employeeStatusTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "EmployeeStatuses")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'employeeStatusId', width: '5%' },
                    {
                        data: 'employeeStatusCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'employeeStatusNameAr' },
                    { data: 'employeeStatusNameEn' },
                    {
                        data: 'description',
                        render: function (data) {
                            return data ? data : '-';
                        }
                    },
                    {
                        data: 'employeeStatusId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editEmployeeStatus(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#employeeStatusId').val(0);
            $('#employeeStatusForm')[0].reset();
            $('#modalTitle').html(localizedStrings.addTitle);
            employeeStatusModal.show();
        }

        function editEmployeeStatus(id) {
            $.get('@Url.Action("GetById", "EmployeeStatuses")/' + id, function (data) {
                if (data) {
                    $('#employeeStatusId').val(data.employeeStatusId);
                    $('#employeeStatusCode').val(data.employeeStatusCode);
                    $('#employeeStatusNameAr').val(data.employeeStatusNameAr);
                    $('#employeeStatusNameEn').val(data.employeeStatusNameEn);
                    $('#description').val(data.description);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    employeeStatusModal.show();
                }
            });
        }

        function saveEmployeeStatus() {
            let model = {
                EmployeeStatusId: parseInt($('#employeeStatusId').val()) || 0,
                EmployeeStatusCode: $('#employeeStatusCode').val(),
                EmployeeStatusNameAr: $('#employeeStatusNameAr').val(),
                EmployeeStatusNameEn: $('#employeeStatusNameEn').val(),
                Description: $('#description').val()
            };

            if (!model.EmployeeStatusCode || !model.EmployeeStatusNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "EmployeeStatuses")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        employeeStatusModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}