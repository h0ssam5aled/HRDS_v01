@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.PenaltyTypes;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-exclamation-octagon fs-3 lh-1 flex-shrink-0 text-danger"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.PenaltyTypes</h4>
                    <p class="text-muted mb-0 small">@Resource.PenaltyTypesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewPenaltyType
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="penaltyTypesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.Code</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.DefaultDeductionDays</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="penaltyTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewPenaltyType</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="penaltyTypeForm">
                    <input type="hidden" id="penaltyTypeId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Code <span class="text-danger">*</span></label>
                        <input type="text" id="penaltyTypeCode" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="penaltyTypeNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="penaltyTypeNameEn" class="form-control" />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.DefaultDeductionDays</label>
                        <input type="number" step="0.5" id="defaultDeductionDays" class="form-control" placeholder="0" />
                    </div>

                    <hr class="border-secondary my-3" />

                    <div class="form-check form-switch text-start">
                        <input class="form-check-input" type="checkbox" id="isActive" checked>
                        <label class="form-check-label text-white me-2" for="isActive">@Resource.IsActive</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="savePenaltyType()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let penaltyTypeModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewPenaltyType)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditPenaltyType)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditPenaltyType)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            penaltyTypeModal = new bootstrap.Modal(document.getElementById('penaltyTypeModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#penaltyTypesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "PenaltyTypes")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'penaltyTypeId', width: '5%' },
                    {
                        data: 'penaltyTypeCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'penaltyTypeNameAr' },
                    { data: 'penaltyTypeNameEn', render: function (data) { return data || '-'; } },
                    {
                        data: 'defaultDeductionDays',
                        render: function (data) {
                            return data !== null && data !== undefined ? `<span class="badge bg-danger">${data}</span>` : '-';
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'penaltyTypeId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editPenaltyType(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#penaltyTypeId').val(0);
            $('#penaltyTypeForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            penaltyTypeModal.show();
        }

        function editPenaltyType(id) {
            $.get('@Url.Action("GetById", "PenaltyTypes")/' + id, function (data) {
                if (data) {
                    $('#penaltyTypeId').val(data.penaltyTypeId);
                    $('#penaltyTypeCode').val(data.penaltyTypeCode);
                    $('#penaltyTypeNameAr').val(data.penaltyTypeNameAr);
                    $('#penaltyTypeNameEn').val(data.penaltyTypeNameEn);
                    $('#defaultDeductionDays').val(data.defaultDeductionDays);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    penaltyTypeModal.show();
                }
            });
        }

        function savePenaltyType() {
            let model = {
                PenaltyTypeId: parseInt($('#penaltyTypeId').val()) || 0,
                PenaltyTypeCode: $('#penaltyTypeCode').val(),
                PenaltyTypeNameAr: $('#penaltyTypeNameAr').val(),
                PenaltyTypeNameEn: $('#penaltyTypeNameEn').val(),
                DefaultDeductionDays: $('#defaultDeductionDays').val() ? parseFloat($('#defaultDeductionDays').val()) : null,
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.PenaltyTypeCode || !model.PenaltyTypeNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "PenaltyTypes")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        penaltyTypeModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}