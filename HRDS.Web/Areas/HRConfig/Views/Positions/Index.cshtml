@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.Positions;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-diagram-2 fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.Positions</h4>
                    <p class="text-muted mb-0 small">@Resource.PositionsDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewPosition
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="positionsTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.PositionCode</th>
                            <th>@Resource.PositionName</th>
                            <th>@Resource.JobTitle</th>
                            <th>@Resource.JobLevel</th>
                            <th>@Resource.ReportsTo</th>
                            <th>@Resource.HeadCount</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="positionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewPosition</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="positionForm">
                    <input type="hidden" id="positionId" value="0" />

                    <div class="row">
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.PositionCode <span class="text-danger">*</span></label>
                            <input type="text" id="positionCode" class="form-control" placeholder="e.g. POS_DEV_01" required />
                        </div>

                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.JobTitle <span class="text-danger">*</span></label>
                            <select id="jobTitleId" class="form-select" required>
                                <option value="">-- @Resource.Select --</option>
                                @if (ViewBag.JobTitles != null)
                                {
                                    foreach (var item in ViewBag.JobTitles)
                                    {
                                        <option value="@item.JobTitleId">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                            <input type="text" id="positionNameAr" class="form-control" required />
                        </div>

                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.EnglishName</label>
                            <input type="text" id="positionNameEn" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.JobLevel</label>
                            <select id="jobLevelId" class="form-select">
                                <option value="">-- @Resource.Select --</option>
                                @if (ViewBag.JobLevels != null)
                                {
                                    foreach (var item in ViewBag.JobLevels)
                                    {
                                        <option value="@item.JobLevelId">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.PositionStatus <span class="text-danger">*</span></label>
                            <select id="positionStatusId" class="form-select" required>
                                <option value="">-- @Resource.Select --</option>
                                @if (ViewBag.PositionStatuses != null)
                                {
                                    foreach (var item in ViewBag.PositionStatuses)
                                    {
                                        <option value="@item.PositionStatusId">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.ReportsTo</label>
                            <select id="reportsToPositionId" class="form-select">
                                <option value="">-- @Resource.Select --</option>
                                @if (ViewBag.Positions != null)
                                {
                                    foreach (var item in ViewBag.Positions)
                                    {
                                        <option value="@item.PositionId">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.Unit</label>
                            <select id="unitId" class="form-select">
                                <option value="">-- @Resource.Select --</option>
                                @if (ViewBag.Units != null)
                                {
                                    foreach (var item in ViewBag.Units)
                                    {
                                        <option value="@item.UnitId">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.EffectiveFrom</label>
                            <input type="date" id="effectiveFrom" class="form-control" />
                        </div>

                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.EffectiveTo</label>
                            <input type="date" id="effectiveTo" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.HeadCount</label>
                            <input type="number" id="headCount" class="form-control" min="1" value="1" />
                        </div>

                        <div class="col-md-8 mb-3 text-start">
                            <label class="form-label text-white">@Resource.Remarks</label>
                            <input type="text" id="remarks" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex gap-4 text-start">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isManagerial">
                            <label class="form-check-label text-white ms-2" for="isManagerial">@Resource.IsManagerial</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isActive" checked>
                            <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="savePosition()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let positionModal;

        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewPosition)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditPosition)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditPosition)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            positionModal = new bootstrap.Modal(document.getElementById('positionModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#positionsTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "Positions")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'positionId', width: '5%' },
                    {
                        data: 'positionCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'displayPositionName' },
                    { data: 'displayJobTitle' },
                    { data: 'displayJobLevel' },
                    { data: 'reportsToPositionName' },
                    { data: 'headCount', render: data => data || 1 },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'positionId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editPosition(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#positionId').val(0);
            $('#positionForm')[0].reset();
            $('#headCount').val(1);
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            positionModal.show();
        }

        function editPosition(id) {
            $.get('@Url.Action("GetById", "Positions")/' + id, function (data) {
                if (data) {
                    $('#positionId').val(data.positionId);
                    $('#unitId').val(data.unitId || '');
                    $('#reportsToPositionId').val(data.reportsToPositionId || '');
                    $('#jobTitleId').val(data.jobTitleId);
                    $('#jobLevelId').val(data.jobLevelId || '');
                    $('#positionStatusId').val(data.positionStatusId);
                    $('#positionCode').val(data.positionCode);
                    $('#positionNameAr').val(data.positionNameAr);
                    $('#positionNameEn').val(data.positionNameEn);
                    $('#headCount').val(data.headCount || 1);
                    $('#effectiveFrom').val(data.effectiveFrom || '');
                    $('#effectiveTo').val(data.effectiveTo || '');
                    $('#remarks').val(data.remarks);
                    $('#isManagerial').prop('checked', data.isManagerial);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    positionModal.show();
                }
            });
        }

        function savePosition() {
            let model = {
                PositionId: parseInt($('#positionId').val()) || 0,
                UnitId: $('#unitId').val() ? parseInt($('#unitId').val()) : null,
                ReportsToPositionId: $('#reportsToPositionId').val() ? parseInt($('#reportsToPositionId').val()) : null,
                JobTitleId: parseInt($('#jobTitleId').val()) || 0,
                JobLevelId: $('#jobLevelId').val() ? parseInt($('#jobLevelId').val()) : null,
                PositionStatusId: parseInt($('#positionStatusId').val()) || 0,
                PositionCode: $('#positionCode').val(),
                PositionNameAr: $('#positionNameAr').val(),
                PositionNameEn: $('#positionNameEn').val(),
                HeadCount: $('#headCount').val() ? parseInt($('#headCount').val()) : null,
                EffectiveFrom: $('#effectiveFrom').val() || null,
                EffectiveTo: $('#effectiveTo').val() || null,
                IsManagerial: $('#isManagerial').is(':checked'),
                Remarks: $('#remarks').val(),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.JobTitleId || !model.PositionStatusId || !model.PositionCode || !model.PositionNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "Positions")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        positionModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}