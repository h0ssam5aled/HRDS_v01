@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.EducationQualifications;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Header Card -->
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-award fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.EducationQualifications</h4>
                    <p class="text-muted mb-0 small">@Resource.EducationQualificationsDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewQualification
            </button>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="qualificationsTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.QualificationCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal الإضافة والتعديل -->
<div class="modal fade" id="qualificationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewQualification</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="qualificationForm">
                    <input type="hidden" id="qualificationId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.QualificationCode <span class="text-danger">*</span></label>
                        <input type="text" id="qualificationCode" class="form-control" placeholder="e.g. BSC-ENG" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="qualificationNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="qualificationNameEn" class="form-control" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveQualification()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let qualificationModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewQualification)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditQualification)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditQualification)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            qualificationModal = new bootstrap.Modal(document.getElementById('qualificationModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#qualificationsTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "EducationQualifications")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'qualificationId', width: '5%' },
                    {
                        data: 'qualificationCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'qualificationNameAr' },
                    { data: 'qualificationNameEn' },
                    {
                        data: 'qualificationId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editQualification(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#qualificationId').val(0);
            $('#qualificationForm')[0].reset();
            $('#modalTitle').html(localizedStrings.addTitle);
            qualificationModal.show();
        }

        function editQualification(id) {
            $.get('@Url.Action("GetById", "EducationQualifications")/' + id, function (data) {
                if (data) {
                    $('#qualificationId').val(data.qualificationId);
                    $('#qualificationCode').val(data.qualificationCode);
                    $('#qualificationNameAr').val(data.qualificationNameAr);
                    $('#qualificationNameEn').val(data.qualificationNameEn);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    qualificationModal.show();
                }
            });
        }

        function saveQualification() {
            let model = {
                QualificationId: parseInt($('#qualificationId').val()) || 0,
                QualificationCode: $('#qualificationCode').val(),
                QualificationNameAr: $('#qualificationNameAr').val(),
                QualificationNameEn: $('#qualificationNameEn').val()
            };

            if (!model.QualificationCode || !model.QualificationNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "EducationQualifications")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        qualificationModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}