@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.HolidayCalendar;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-calendar-event fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.HolidayCalendar</h4>
                    <p class="text-muted mb-0 small">@Resource.HolidayCalendarDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewHoliday
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="holidayTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.StartDate</th>
                            <th>@Resource.EndDate</th>
                            <th>@Resource.TotalDays</th>
                            <th>@Resource.Year</th>
                            <th>@Resource.IsRecurring</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="holidayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewHoliday</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="holidayForm">
                    <input type="hidden" id="holidayId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="holidayNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="holidayNameEn" class="form-control" />
                    </div>

                    <div class="row mb-3 text-start">
                        <div class="col-md-6">
                            <label class="form-label text-white">@Resource.StartDate <span class="text-danger">*</span></label>
                            <input type="date" id="startDate" class="form-control" required onchange="calculateDays()" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white">@Resource.EndDate <span class="text-danger">*</span></label>
                            <input type="date" id="endDate" class="form-control" required onchange="calculateDays()" />
                        </div>
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.TotalDays</label>
                        <input type="number" id="totalDays" class="form-control" readonly />
                    </div>

                    <div class="row mb-3 text-start">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isRecurring">
                                <label class="form-check-label text-white ms-2" for="isRecurring">@Resource.IsRecurring</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveHoliday()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let holidayModal;

        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewHoliday)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditHoliday)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditHoliday)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            yes: @Html.Raw(Json.Serialize(Resource.Yes)),
            no: @Html.Raw(Json.Serialize(Resource.No)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage)),
            dateError: @Html.Raw(Json.Serialize(Resource.DateErrorMessage))
        };

        $(document).ready(function () {
            holidayModal = new bootstrap.Modal(document.getElementById('holidayModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#holidayTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "HolidayCalendars")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'holidayId', width: '5%' },
                    { data: 'holidayNameAr' },
                    { data: 'holidayNameEn', render: data => data || '-' },
                    { data: 'startDate' },
                    { data: 'endDate' },
                    {
                        data: 'totalDays',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data}</span>`;
                        }
                    },
                    { data: 'year' },
                    {
                        data: 'isRecurring',
                        render: function (data) {
                            return data ? `<span class="badge bg-success px-2 py-1">${localizedStrings.yes}</span>`
                                        : `<span class="badge bg-secondary px-2 py-1">${localizedStrings.no}</span>`;
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'holidayId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editHoliday(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function calculateDays() {
            let startVal = $('#startDate').val();
            let endVal = $('#endDate').val();

            if (startVal && endVal) {
                let start = new Date(startVal);
                let end = new Date(endVal);

                if (end >= start) {
                    let diffTime = Math.abs(end - start);
                    let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                    $('#totalDays').val(diffDays);
                } else {
                    $('#totalDays').val(0);
                }
            } else {
                $('#totalDays').val(0);
            }
        }

        function openAddModal() {
            $('#holidayId').val(0);
            $('#holidayForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#isRecurring').prop('checked', false);
            $('#totalDays').val(0);
            $('#modalTitle').html(localizedStrings.addTitle);
            holidayModal.show();
        }

        function editHoliday(id) {
            $.get('@Url.Action("GetById", "HolidayCalendars")/' + id, function (data) {
                if (data) {
                    $('#holidayId').val(data.holidayId);
                    $('#holidayNameAr').val(data.holidayNameAr);
                    $('#holidayNameEn').val(data.holidayNameEn);
                    $('#startDate').val(data.startDate);
                    $('#endDate').val(data.endDate);
                    $('#totalDays').val(data.totalDays);
                    $('#isRecurring').prop('checked', data.isRecurring);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    holidayModal.show();
                }
            });
        }

        function saveHoliday() {
            let model = {
                HolidayId: parseInt($('#holidayId').val()) || 0,
                HolidayNameAr: $('#holidayNameAr').val(),
                HolidayNameEn: $('#holidayNameEn').val(),
                StartDate: $('#startDate').val(),
                EndDate: $('#endDate').val(),
                IsRecurring: $('#isRecurring').is(':checked'),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.HolidayNameAr || !model.StartDate || !model.EndDate) {
                alert(localizedStrings.requiredError);
                return;
            }

            if (new Date(model.EndDate) < new Date(model.StartDate)) {
                alert(localizedStrings.dateError || "End date cannot be earlier than start date.");
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "HolidayCalendars")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        holidayModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}