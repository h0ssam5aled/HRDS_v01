@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.ApproverTypes;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-person-check fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.ApproverTypes</h4>
                    <p class="text-muted mb-0 small">@Resource.ApproverTypesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewApproverType
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="approverTypesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.ApproverTypeCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.RequiresJobTitle</th>
                            <th>@Resource.RequiresEmployee</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="approverTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewApproverType</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="approverTypeForm">
                    <input type="hidden" id="approverTypeId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ApproverTypeCode <span class="text-danger">*</span></label>
                        <input type="text" id="approverTypeCode" class="form-control" placeholder="e.g. DIRECT_MANAGER" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="approverTypeNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="approverTypeNameEn" class="form-control" />
                    </div>

                    <div class="row mb-3 text-start">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="requiresJobTitle">
                                <label class="form-check-label text-white ms-2" for="requiresJobTitle">@Resource.RequiresJobTitle</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="requiresEmployee">
                                <label class="form-check-label text-white ms-2" for="requiresEmployee">@Resource.RequiresEmployee</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch text-start">
                        <input class="form-check-input" type="checkbox" id="isActive" checked>
                        <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveApproverType()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let approverTypeModal;

        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewApproverType)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditApproverType)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditApproverType)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            yes: @Html.Raw(Json.Serialize(Resource.Yes)),
            no: @Html.Raw(Json.Serialize(Resource.No)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            approverTypeModal = new bootstrap.Modal(document.getElementById('approverTypeModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#approverTypesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "ApproverTypes")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'approverTypeId', width: '5%' },
                    {
                        data: 'approverTypeCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'approverTypeNameAr' },
                    { data: 'approverTypeNameEn', render: data => data || '-' },
                            {
            data: 'requiresJobTitle',
            render: function (data) {
                return data ? `<span class="badge bg-success px-2 py-1">${localizedStrings.yes}</span>`
                            : `<span class="badge bg-secondary px-2 py-1">${localizedStrings.no}</span>`;
            }
        },
        {
            data: 'requiresEmployee',
            render: function (data) {
                return data ? `<span class="badge bg-success px-2 py-1">${localizedStrings.yes}</span>`
                            : `<span class="badge bg-secondary px-2 py-1">${localizedStrings.no}</span>`;
            }
        },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'approverTypeId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editApproverType(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#approverTypeId').val(0);
            $('#approverTypeForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#requiresJobTitle').prop('checked', false);
            $('#requiresEmployee').prop('checked', false);
            $('#modalTitle').html(localizedStrings.addTitle);
            approverTypeModal.show();
        }

        function editApproverType(id) {
            $.get('@Url.Action("GetById", "ApproverTypes")/' + id, function (data) {
                if (data) {
                    $('#approverTypeId').val(data.approverTypeId);
                    $('#approverTypeCode').val(data.approverTypeCode);
                    $('#approverTypeNameAr').val(data.approverTypeNameAr);
                    $('#approverTypeNameEn').val(data.approverTypeNameEn);
                    $('#requiresJobTitle').prop('checked', data.requiresJobTitle);
                    $('#requiresEmployee').prop('checked', data.requiresEmployee);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    approverTypeModal.show();
                }
            });
        }

        function saveApproverType() {
            let model = {
                ApproverTypeId: parseInt($('#approverTypeId').val()) || 0,
                ApproverTypeCode: $('#approverTypeCode').val(),
                ApproverTypeNameAr: $('#approverTypeNameAr').val(),
                ApproverTypeNameEn: $('#approverTypeNameEn').val(),
                RequiresJobTitle: $('#requiresJobTitle').is(':checked'),
                RequiresEmployee: $('#requiresEmployee').is(':checked'),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.ApproverTypeCode || !model.ApproverTypeNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "ApproverTypes")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        approverTypeModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}