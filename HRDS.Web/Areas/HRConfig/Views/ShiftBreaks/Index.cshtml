@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.ShiftBreaks;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-cup-hot fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.ShiftBreaks</h4>
                    <p class="text-muted mb-0 small">@Resource.ShiftBreaksDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewBreak
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="breaksTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.Shift</th>
                            <th>@Resource.BreakCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.Timing</th>
                            <th>@Resource.IsPaidBreak</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal الإضافة والتعديل -->
<div class="modal fade" id="breakModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewBreak</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="breakForm">
                    <input type="hidden" id="breakId" value="0" />

                    <div class="row">
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.Shift <span class="text-danger">*</span></label>
                            <select id="shiftId" class="form-select" asp-items="ViewBag.Shifts" required>
                                <option value="">-- @Resource.Select --</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.BreakCode <span class="text-danger">*</span></label>
                            <input type="text" id="breakCode" class="form-control" placeholder="e.g. LUNCH_BREAK" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                            <input type="text" id="breakNameAr" class="form-control" required />
                        </div>

                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.EnglishName</label>
                            <input type="text" id="breakNameEn" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.FromTime <span class="text-danger">*</span></label>
                            <input type="time" id="fromTime" class="form-control" required />
                        </div>

                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.ToTime <span class="text-danger">*</span></label>
                            <input type="time" id="toTime" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Description</label>
                        <textarea id="description" class="form-control" rows="2"></textarea>
                    </div>

                    <hr class="border-secondary my-3" />

                    <div class="row">
                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isPaidBreak">
                                <label class="form-check-label text-white me-2" for="isPaidBreak">@Resource.IsPaidBreak</label>
                            </div>
                        </div>

                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label text-white me-2" for="isActive">@Resource.IsActive</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveBreak()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let breakModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewBreak)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditBreak)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditBreak)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            yes: @Html.Raw(Json.Serialize(Resource.Yes)),
            no: @Html.Raw(Json.Serialize(Resource.No)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            breakModal = new bootstrap.Modal(document.getElementById('breakModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#breaksTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "ShiftBreaks")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'breakId', width: '5%' },
                    { data: 'shiftNameAr' },
                    {
                        data: 'breakCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'breakNameAr' },
                    {
                        data: null,
                        render: function (row) {
                            return `<span class="badge bg-dark border border-secondary text-info">${row.fromTime} - ${row.toTime}</span>`;
                        }
                    },
                    {
                        data: 'isPaidBreak',
                        render: function (data) {
                            return data ? `<span class="badge bg-success">${localizedStrings.yes}</span>`
                                        : `<span class="badge bg-secondary">${localizedStrings.no}</span>`;
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'breakId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editBreak(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#breakId').val(0);
            $('#breakForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            breakModal.show();
        }

        function editBreak(id) {
            $.get('@Url.Action("GetById", "ShiftBreaks")/' + id, function (data) {
                if (data) {
                    $('#breakId').val(data.breakId);
                    $('#shiftId').val(data.shiftId);
                    $('#breakCode').val(data.breakCode);
                    $('#breakNameAr').val(data.breakNameAr);
                    $('#breakNameEn').val(data.breakNameEn);
                    $('#fromTime').val(data.fromTime);
                    $('#toTime').val(data.toTime);
                    $('#description').val(data.description);
                    $('#isPaidBreak').prop('checked', data.isPaidBreak);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    breakModal.show();
                }
            });
        }

        function saveBreak() {
            let rawFromTime = $('#fromTime').val();
            let rawToTime = $('#toTime').val();

            let formattedFromTime = rawFromTime ? (rawFromTime.length === 5 ? rawFromTime + ':00' : rawFromTime) : null;
            let formattedToTime = rawToTime ? (rawToTime.length === 5 ? rawToTime + ':00' : rawToTime) : null;

            let model = {
                BreakId: parseInt($('#breakId').val()) || 0,
                ShiftId: parseInt($('#shiftId').val()),
                BreakCode: $('#breakCode').val(),
                BreakNameAr: $('#breakNameAr').val(),
                BreakNameEn: $('#breakNameEn').val(),
                FromTime: formattedFromTime,
                ToTime: formattedToTime,
                Description: $('#description').val(),
                IsPaidBreak: $('#isPaidBreak').is(':checked'),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.ShiftId || !model.BreakCode || !model.BreakNameAr || !model.FromTime || !model.ToTime) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "ShiftBreaks")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        breakModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}