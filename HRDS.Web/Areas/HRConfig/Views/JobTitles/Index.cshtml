@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.JobTitles;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-briefcase fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.JobTitles</h4>
                    <p class="text-muted mb-0 small">@Resource.JobTitlesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewJobTitle
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="jobTitlesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.JobTitleCode</th>
                            <th>@Resource.JobGroup</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="jobTitleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewJobTitle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="jobTitleForm">
                    <input type="hidden" id="jobTitleId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.JobGroup <span class="text-danger">*</span></label>
                        <select id="jobGroupId" class="form-select" required>
                            <option value="">-- @Resource.Select --</option>
                            @if (ViewBag.JobGroups != null)
                            {
                                foreach (var group in ViewBag.JobGroups)
                                {
                                    <option value="@group.JobGroupId">@group.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.JobTitleCode <span class="text-danger">*</span></label>
                        <input type="text" id="jobTitleCode" class="form-control" placeholder="e.g. SR_DEV" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="jobTitleNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="jobTitleNameEn" class="form-control" />
                    </div>

                    <div class="form-check form-switch text-start">
                        <input class="form-check-input" type="checkbox" id="isActive" checked>
                        <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveJobTitle()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let jobTitleModal;

        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewJobTitle)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditJobTitle)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditJobTitle)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            jobTitleModal = new bootstrap.Modal(document.getElementById('jobTitleModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#jobTitlesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "JobTitles")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'jobTitleId', width: '5%' },
                    {
                        data: 'jobTitleCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'displayJobGroupName' },
                    { data: 'jobTitleNameAr' },
                    { data: 'jobTitleNameEn', render: data => data || '-' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'jobTitleId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editJobTitle(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#jobTitleId').val(0);
            $('#jobTitleForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            jobTitleModal.show();
        }

        function editJobTitle(id) {
            $.get('@Url.Action("GetById", "JobTitles")/' + id, function (data) {
                if (data) {
                    $('#jobTitleId').val(data.jobTitleId);
                    $('#jobGroupId').val(data.jobGroupId);
                    $('#jobTitleCode').val(data.jobTitleCode);
                    $('#jobTitleNameAr').val(data.jobTitleNameAr);
                    $('#jobTitleNameEn').val(data.jobTitleNameEn);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    jobTitleModal.show();
                }
            });
        }

        function saveJobTitle() {
            let model = {
                JobTitleId: parseInt($('#jobTitleId').val()) || 0,
                JobGroupId: parseInt($('#jobGroupId').val()) || 0,
                JobTitleCode: $('#jobTitleCode').val(),
                JobTitleNameAr: $('#jobTitleNameAr').val(),
                JobTitleNameEn: $('#jobTitleNameEn').val(),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.JobGroupId || !model.JobTitleCode || !model.JobTitleNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "JobTitles")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        jobTitleModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}