@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.EducationGrades;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Header Card -->
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-star fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.EducationGrades</h4>
                    <p class="text-muted mb-0 small">@Resource.EducationGradesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewGrade
            </button>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="gradesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.GradeCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal الإضافة والتعديل -->
<div class="modal fade" id="gradeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewGrade</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="gradeForm">
                    <input type="hidden" id="gradeId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.GradeCode <span class="text-danger">*</span></label>
                        <input type="text" id="gradeCode" class="form-control" placeholder="e.g. EXCELLENT" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="gradeNameAr" class="form-control" placeholder="مثال: ممتاز" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="gradeNameEn" class="form-control" placeholder="e.g. Excellent" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveGrade()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let gradeModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewGrade)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditGrade)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditGrade)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            gradeModal = new bootstrap.Modal(document.getElementById('gradeModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#gradesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "EducationGrades")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'gradeId', width: '5%' },
                    {
                        data: 'gradeCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'gradeNameAr' },
                    { data: 'gradeNameEn' },
                    {
                        data: 'gradeId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editGrade(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#gradeId').val(0);
            $('#gradeForm')[0].reset();
            $('#modalTitle').html(localizedStrings.addTitle);
            gradeModal.show();
        }

        function editGrade(id) {
            $.get('@Url.Action("GetById", "EducationGrades")/' + id, function (data) {
                if (data) {
                    $('#gradeId').val(data.gradeId);
                    $('#gradeCode').val(data.gradeCode);
                    $('#gradeNameAr').val(data.gradeNameAr);
                    $('#gradeNameEn').val(data.gradeNameEn);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    gradeModal.show();
                }
            });
        }

        function saveGrade() {
            let model = {
                GradeId: parseInt($('#gradeId').val()) || 0,
                GradeCode: $('#gradeCode').val(),
                GradeNameAr: $('#gradeNameAr').val(),
                GradeNameEn: $('#gradeNameEn').val()
            };

            if (!model.GradeCode || !model.GradeNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "EducationGrades")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        gradeModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}