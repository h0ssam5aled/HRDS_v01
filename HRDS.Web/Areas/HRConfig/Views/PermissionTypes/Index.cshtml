@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.PermissionTypes;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-clock-history fs-3 lh-1 flex-shrink-0 text-warning"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.PermissionTypes</h4>
                    <p class="text-muted mb-0 small">@Resource.PermissionTypesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewPermissionType
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="permissionTypesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.Code</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.MaxHoursPerMonth</th>
                            <th>@Resource.MaxCountPerMonth</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="permissionTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewPermissionType</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="permissionTypeForm">
                    <input type="hidden" id="permissionTypeId" value="0" />

                    <div class="row">
                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.Code <span class="text-danger">*</span></label>
                            <input type="text" id="permissionTypeCode" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                            <input type="text" id="permissionTypeNameAr" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.EnglishName</label>
                            <input type="text" id="permissionTypeNameEn" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.MaxHoursPerMonth</label>
                            <input type="number" step="0.25" id="maxHoursPerMonth" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.MaxCountPerMonth</label>
                            <input type="number" id="maxCountPerMonth" class="form-control" placeholder="0" />
                        </div>
                    </div>

                    <hr class="border-secondary my-3" />

                    <div class="row">
                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="deductFromSalary">
                                <label class="form-check-label text-white me-2" for="deductFromSalary">@Resource.DeductFromSalary</label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="deductFromLeaveBalance">
                                <label class="form-check-label text-white me-2" for="deductFromLeaveBalance">@Resource.DeductFromLeaveBalance</label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="requiresAttachment">
                                <label class="form-check-label text-white me-2" for="requiresAttachment">@Resource.RequiresAttachment</label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label text-white me-2" for="isActive">@Resource.IsActive</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="savePermissionType()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let permissionTypeModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewPermissionType)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditPermissionType)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditPermissionType)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            permissionTypeModal = new bootstrap.Modal(document.getElementById('permissionTypeModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#permissionTypesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "PermissionTypes")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'permissionTypeId', width: '5%' },
                    {
                        data: 'permissionTypeCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'permissionTypeNameAr' },
                    { data: 'permissionTypeNameEn', render: function (data) { return data || '-'; } },
                    { data: 'maxHoursPerMonth', render: function (data) { return data ?? '-'; } },
                    { data: 'maxCountPerMonth', render: function (data) { return data ?? '-'; } },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'permissionTypeId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editPermissionType(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#permissionTypeId').val(0);
            $('#permissionTypeForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            permissionTypeModal.show();
        }

        function editPermissionType(id) {
            $.get('@Url.Action("GetById", "PermissionTypes")/' + id, function (data) {
                if (data) {
                    $('#permissionTypeId').val(data.permissionTypeId);
                    $('#permissionTypeCode').val(data.permissionTypeCode);
                    $('#permissionTypeNameAr').val(data.permissionTypeNameAr);
                    $('#permissionTypeNameEn').val(data.permissionTypeNameEn);
                    $('#maxHoursPerMonth').val(data.maxHoursPerMonth);
                    $('#maxCountPerMonth').val(data.maxCountPerMonth);
                    $('#deductFromSalary').prop('checked', data.deductFromSalary);
                    $('#deductFromLeaveBalance').prop('checked', data.deductFromLeaveBalance);
                    $('#requiresAttachment').prop('checked', data.requiresAttachment);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    permissionTypeModal.show();
                }
            });
        }

        function savePermissionType() {
            let model = {
                PermissionTypeId: parseInt($('#permissionTypeId').val()) || 0,
                PermissionTypeCode: $('#permissionTypeCode').val(),
                PermissionTypeNameAr: $('#permissionTypeNameAr').val(),
                PermissionTypeNameEn: $('#permissionTypeNameEn').val(),
                MaxHoursPerMonth: $('#maxHoursPerMonth').val() ? parseFloat($('#maxHoursPerMonth').val()) : null,
                MaxCountPerMonth: $('#maxCountPerMonth').val() ? parseInt($('#maxCountPerMonth').val()) : null,
                DeductFromSalary: $('#deductFromSalary').is(':checked'),
                DeductFromLeaveBalance: $('#deductFromLeaveBalance').is(':checked'),
                RequiresAttachment: $('#requiresAttachment').is(':checked'),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.PermissionTypeCode || !model.PermissionTypeNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "PermissionTypes")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        permissionTypeModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}
