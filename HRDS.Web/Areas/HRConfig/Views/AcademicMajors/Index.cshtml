@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.AcademicMajors;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Header Card -->
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-mortarboard-fill fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.AcademicMajors</h4>
                    <p class="text-muted mb-0 small">@Resource.AcademicMajorsDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewAcademicMajor
            </button>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="majorsTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.MajorCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Faculty</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal الإضافة والتعديل الداكن -->
<div class="modal fade" id="majorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewAcademicMajor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="majorForm">
                    <input type="hidden" id="majorId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Faculty <span class="text-danger">*</span></label>
                        <select id="facultyId" class="form-select" asp-items="ViewBag.Faculties" required>
                            <option value="">-- @Resource.SelectFaculty --</option>
                        </select>
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.MajorCode <span class="text-danger">*</span></label>
                        <input type="text" id="majorCode" class="form-control" placeholder="e.g. CS-01" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="majorNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="majorNameEn" class="form-control" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveMajor()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let majorModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewAcademicMajor)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditAcademicMajor)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditAcademicMajor)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            majorModal = new bootstrap.Modal(document.getElementById('majorModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#majorsTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "AcademicMajors")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'majorId', width: '5%' },
                    {
                        data: 'majorCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'majorNameAr' },
                    { data: 'majorNameEn' },
                    {
                        data: '@(isRtl ? "facultyNameAr" : "facultyNameEn")',
                        defaultContent: ''
                    },
                    {
                        data: 'majorId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-outline-info" onclick="editMajor(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#majorId').val(0);
            $('#majorForm')[0].reset();
            $('#modalTitle').html(localizedStrings.addTitle);
            majorModal.show();
        }

        function editMajor(id) {
            $.get('@Url.Action("GetById", "AcademicMajors")/' + id, function (data) {
                if (data) {
                    $('#majorId').val(data.majorId);
                    $('#facultyId').val(data.facultyId);
                    $('#majorCode').val(data.majorCode);
                    $('#majorNameAr').val(data.majorNameAr);
                    $('#majorNameEn').val(data.majorNameEn);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    majorModal.show();
                }
            });
        }

        function saveMajor() {
            let model = {
                MajorId: parseInt($('#majorId').val()) || 0,
                FacultyId: parseInt($('#facultyId').val()),
                MajorCode: $('#majorCode').val(),
                MajorNameAr: $('#majorNameAr').val(),
                MajorNameEn: $('#majorNameEn').val()
            };

            if (!model.FacultyId || !model.MajorCode || !model.MajorNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "AcademicMajors")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        majorModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}