@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.SafetyTypes;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-shield-exclamation fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.SafetyTypes</h4>
                    <p class="text-muted mb-0 small">@Resource.SafetyTypesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewSafetyType
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="safetyTypesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.SafetyTypeCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.SeverityLevel</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="safetyTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewSafetyType</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="safetyTypeForm">
                    <input type="hidden" id="safetyTypeId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.SafetyTypeCode <span class="text-danger">*</span></label>
                        <input type="text" id="safetyTypeCode" class="form-control" placeholder="e.g. FIRE" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="safetyTypeNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="safetyTypeNameEn" class="form-control" />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.SeverityLevel</label>
                        <input type="number" id="severityLevel" class="form-control" min="1" max="10" placeholder="1 - 10" />
                    </div>

                    <div class="form-check form-switch text-start">
                        <input class="form-check-input" type="checkbox" id="isActive" checked>
                        <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveSafetyType()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let safetyTypeModal;

        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewSafetyType)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditSafetyType)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditSafetyType)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            safetyTypeModal = new bootstrap.Modal(document.getElementById('safetyTypeModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#safetyTypesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "SafetyTypes")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'safetyTypeId', width: '5%' },
                    {
                        data: 'safetyTypeCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'safetyTypeNameAr' },
                    { data: 'safetyTypeNameEn', render: data => data || '-' },
                    {
                        data: 'severityLevel',
                        render: function (data) {
                            return data ? `<span class="badge bg-danger bg-opacity-25 text-danger border border-danger px-2 py-1">${data}</span>` : '-';
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'safetyTypeId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editSafetyType(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#safetyTypeId').val(0);
            $('#safetyTypeForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            safetyTypeModal.show();
        }

        function editSafetyType(id) {
            $.get('@Url.Action("GetById", "SafetyTypes")/' + id, function (data) {
                if (data) {
                    $('#safetyTypeId').val(data.safetyTypeId);
                    $('#safetyTypeCode').val(data.safetyTypeCode);
                    $('#safetyTypeNameAr').val(data.safetyTypeNameAr);
                    $('#safetyTypeNameEn').val(data.safetyTypeNameEn);
                    $('#severityLevel').val(data.severityLevel);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    safetyTypeModal.show();
                }
            });
        }

        function saveSafetyType() {
            let model = {
                SafetyTypeId: parseInt($('#safetyTypeId').val()) || 0,
                SafetyTypeCode: $('#safetyTypeCode').val(),
                SafetyTypeNameAr: $('#safetyTypeNameAr').val(),
                SafetyTypeNameEn: $('#safetyTypeNameEn').val(),
                SeverityLevel: $('#severityLevel').val() ? parseInt($('#severityLevel').val()) : null,
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.SafetyTypeCode || !model.SafetyTypeNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "SafetyTypes")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        safetyTypeModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}