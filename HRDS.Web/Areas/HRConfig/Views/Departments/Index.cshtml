@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.Departments;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-building fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.Departments</h4>
                    <p class="text-muted mb-0 small">@Resource.DepartmentsDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewDepartment
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="departmentsTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.Code</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="departmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewDepartment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="departmentForm">
                    <input type="hidden" id="departmentId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Code <span class="text-danger">*</span></label>
                        <input type="text" id="departmentCode" class="form-control" placeholder="e.g. HR-DEP" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="departmentNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="departmentNameEn" class="form-control" />
                    </div>

                    <div class="form-check form-switch text-start">
                        <input class="form-check-input" type="checkbox" id="isActive" checked>
                        <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveDepartment()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let departmentModal;

        // تجهيز نصوص الموارد لمنع مشاكل ה-HTML Encoding والنصوص المشفرة
        const txtAddNewDepartment = @Html.Raw(Json.Serialize(Resource.AddNewDepartment));
        const txtEditDepartment = @Html.Raw(Json.Serialize(Resource.EditDepartment));
        const txtRequiredFields = @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage));
        const txtAnErrorOccurred = @Html.Raw(Json.Serialize(Resource.AnErrorOccurred));
        const txtActive = @Html.Raw(Json.Serialize(Resource.Active));
        const txtInactive = @Html.Raw(Json.Serialize(Resource.Inactive));

        $(document).ready(function () {
            departmentModal = new bootstrap.Modal(document.getElementById('departmentModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#departmentsTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "Departments", new { area = "HRConfig" })',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'departmentId', width: '5%' },
                    {
                        data: 'departmentCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'departmentNameAr' },
                    { data: 'departmentNameEn', render: d => d || '-' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${txtActive}</span>`
                                        : `<span class="badge neon-badge-muted">${txtInactive}</span>`;
                        }
                    },
                    {
                        data: 'departmentId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editDepartment(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${txtEditDepartment}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#departmentId').val(0);
            $('#departmentForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(txtAddNewDepartment);
            departmentModal.show();
        }

        function editDepartment(id) {
            $.get('@Url.Action("GetById", "Departments", new { area = "HRConfig" })/' + id, function (data) {
                if (data) {
                    $('#departmentId').val(data.departmentId);
                    $('#departmentCode').val(data.departmentCode);
                    $('#departmentNameAr').val(data.departmentNameAr);
                    $('#departmentNameEn').val(data.departmentNameEn);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(txtEditDepartment);
                    departmentModal.show();
                }
            });
        }

        function saveDepartment() {
            let model = {
                DepartmentId: parseInt($('#departmentId').val()) || 0,
                DepartmentCode: $('#departmentCode').val(),
                DepartmentNameAr: $('#departmentNameAr').val(),
                DepartmentNameEn: $('#departmentNameEn').val(),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.DepartmentCode || !model.DepartmentNameAr) {
                alert(txtRequiredFields);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "Departments", new { area = "HRConfig" })',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        departmentModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(txtAnErrorOccurred);
                }
            });
        }
    </script>
}