@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.ExpenseTypes;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-receipt fs-3 lh-1 flex-shrink-0 text-success"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.ExpenseTypes</h4>
                    <p class="text-muted mb-0 small">@Resource.ExpenseTypesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewExpenseType
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="expenseTypesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.Code</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.MaxLimitAmount</th>
                            <th>@Resource.RequiresAttachment</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="expenseTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewExpenseType</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="expenseTypeForm">
                    <input type="hidden" id="expenseTypeId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Code <span class="text-danger">*</span></label>
                        <input type="text" id="expenseTypeCode" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="expenseTypeNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="expenseTypeNameEn" class="form-control" />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Description</label>
                        <textarea id="description" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.MaxLimitAmount</label>
                        <input type="number" step="0.01" id="maxLimit" class="form-control" placeholder="0.00" />
                    </div>

                    <hr class="border-secondary my-3" />

                    <div class="row">
                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="requiresAttachment">
                                <label class="form-check-label text-white me-2" for="requiresAttachment">@Resource.RequiresAttachment</label>
                            </div>
                        </div>

                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label text-white me-2" for="isActive">@Resource.IsActive</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveExpenseType()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let expenseTypeModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewExpenseType)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditExpenseType)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditExpenseType)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            yes: @Html.Raw(Json.Serialize(Resource.Yes)),
            no: @Html.Raw(Json.Serialize(Resource.No)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            expenseTypeModal = new bootstrap.Modal(document.getElementById('expenseTypeModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#expenseTypesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "ExpenseTypes")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'expenseTypeId', width: '5%' },
                    {
                        data: 'expenseTypeCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'expenseTypeNameAr' },
                    { data: 'expenseTypeNameEn', render: function (data) { return data || '-'; } },
                    {
                        data: 'maxLimit',
                        render: function (data) {
                            return data !== null && data !== undefined ? `<span class="badge bg-primary">${data}</span>` : '-';
                        }
                    },
                    {
                        data: 'requiresAttachment',
                        render: function (data) {
                            return data ? `<span class="badge bg-info">${localizedStrings.yes}</span>`
                                        : `<span class="badge bg-secondary">${localizedStrings.no}</span>`;
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'expenseTypeId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editExpenseType(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#expenseTypeId').val(0);
            $('#expenseTypeForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            expenseTypeModal.show();
        }

        function editExpenseType(id) {
            $.get('@Url.Action("GetById", "ExpenseTypes")/' + id, function (data) {
                if (data) {
                    $('#expenseTypeId').val(data.expenseTypeId);
                    $('#expenseTypeCode').val(data.expenseTypeCode);
                    $('#expenseTypeNameAr').val(data.expenseTypeNameAr);
                    $('#expenseTypeNameEn').val(data.expenseTypeNameEn);
                    $('#description').val(data.description);
                    $('#maxLimit').val(data.maxLimit);
                    $('#requiresAttachment').prop('checked', data.requiresAttachment);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    expenseTypeModal.show();
                }
            });
        }

        function saveExpenseType() {
            let model = {
                ExpenseTypeId: parseInt($('#expenseTypeId').val()) || 0,
                ExpenseTypeCode: $('#expenseTypeCode').val(),
                ExpenseTypeNameAr: $('#expenseTypeNameAr').val(),
                ExpenseTypeNameEn: $('#expenseTypeNameEn').val(),
                Description: $('#description').val(),
                MaxLimit: $('#maxLimit').val() ? parseFloat($('#maxLimit').val()) : null,
                RequiresAttachment: $('#requiresAttachment').is(':checked'),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.ExpenseTypeCode || !model.ExpenseTypeNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "ExpenseTypes")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        expenseTypeModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}