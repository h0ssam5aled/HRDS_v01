@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.AssetTypes;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-box-seam fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.AssetTypes</h4>
                    <p class="text-muted mb-0 small">@Resource.AssetTypesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewAssetType
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="assetTypesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.AssetTypeCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="assetTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewAssetType</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="assetTypeForm">
                    <input type="hidden" id="assetTypeId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.AssetTypeCode <span class="text-danger">*</span></label>
                        <input type="text" id="assetTypeCode" class="form-control" placeholder="e.g. LAPTOP" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="assetTypeNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="assetTypeNameEn" class="form-control" />
                    </div>

                    <div class="form-check form-switch text-start">
                        <input class="form-check-input" type="checkbox" id="isActive" checked>
                        <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveAssetType()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let assetTypeModal;

        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewAssetType)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditAssetType)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditAssetType)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            assetTypeModal = new bootstrap.Modal(document.getElementById('assetTypeModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#assetTypesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "AssetTypes")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'assetTypeId', width: '5%' },
                    {
                        data: 'assetTypeCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'assetTypeNameAr' },
                    { data: 'assetTypeNameEn', render: data => data || '-' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'assetTypeId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editAssetType(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#assetTypeId').val(0);
            $('#assetTypeForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            assetTypeModal.show();
        }

        function editAssetType(id) {
            $.get('@Url.Action("GetById", "AssetTypes")/' + id, function (data) {
                if (data) {
                    $('#assetTypeId').val(data.assetTypeId);
                    $('#assetTypeCode').val(data.assetTypeCode);
                    $('#assetTypeNameAr').val(data.assetTypeNameAr);
                    $('#assetTypeNameEn').val(data.assetTypeNameEn);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    assetTypeModal.show();
                }
            });
        }

        function saveAssetType() {
            let model = {
                AssetTypeId: parseInt($('#assetTypeId').val()) || 0,
                AssetTypeCode: $('#assetTypeCode').val(),
                AssetTypeNameAr: $('#assetTypeNameAr').val(),
                AssetTypeNameEn: $('#assetTypeNameEn').val(),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.AssetTypeCode || !model.AssetTypeNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "AssetTypes")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        assetTypeModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}