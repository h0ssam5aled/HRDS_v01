@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.Shifts;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-alarm fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.Shifts</h4>
                    <p class="text-muted mb-0 small">@Resource.ShiftsDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewShift
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="shiftsTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.ShiftCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.ShiftType</th>
                            <th>@Resource.Timing</th>
                            <th>@Resource.StandardHours</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal الإضافة والتعديل للورديات -->
<div class="modal fade" id="shiftModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewShift</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="shiftForm">
                    <input type="hidden" id="shiftId" value="0" />

                    <div class="row">
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.ShiftType <span class="text-danger">*</span></label>
                            <select id="shiftTypeId" class="form-select" asp-items="ViewBag.ShiftTypes" required>
                                <option value="">-- @Resource.Select --</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.ShiftCode <span class="text-danger">*</span></label>
                            <input type="text" id="shiftCode" class="form-control" placeholder="e.g. MORNING_A" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                            <input type="text" id="shiftNameAr" class="form-control" required />
                        </div>

                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.EnglishName</label>
                            <input type="text" id="shiftNameEn" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.StartTime <span class="text-danger">*</span></label>
                            <input type="time" id="startTime" class="form-control" required />
                        </div>

                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.EndTime <span class="text-danger">*</span></label>
                            <input type="time" id="endTime" class="form-control" required />
                        </div>

                        <div class="col-md-4 mb-3 text-start">
                            <label class="form-label text-white">@Resource.StandardHours</label>
                            <input type="number" step="0.5" id="standardHours" class="form-control" placeholder="8.00" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.GraceInMinutes</label>
                            <input type="number" id="graceInMinutes" class="form-control" value="0" />
                        </div>

                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.GraceOutMinutes</label>
                            <input type="number" id="graceOutMinutes" class="form-control" value="0" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3 text-start">
                            <label class="form-label text-white">@Resource.MinimumOvertimeMinutes</label>
                            <input type="number" id="minimumOvertimeMinutes" class="form-control" value="0" />
                        </div>
                    </div>

                    <hr class="border-secondary my-3" />

                    <div class="row">
                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="crossMidnight">
                                <label class="form-check-label text-white me-2" for="crossMidnight">@Resource.CrossMidnight</label>
                            </div>
                        </div>

                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="allowOvertime">
                                <label class="form-check-label text-white me-2" for="allowOvertime">@Resource.AllowOvertime</label>
                            </div>
                        </div>

                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="allowLateDeduction" checked>
                                <label class="form-check-label text-white me-2" for="allowLateDeduction">@Resource.AllowLateDeduction</label>
                            </div>
                        </div>

                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="autoCloseAttendance">
                                <label class="form-check-label text-white me-2" for="autoCloseAttendance">@Resource.AutoCloseAttendance</label>
                            </div>
                        </div>

                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label text-white me-2" for="isActive">@Resource.IsActive</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveShift()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let shiftModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewShift)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditShift)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditShift)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            shiftModal = new bootstrap.Modal(document.getElementById('shiftModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#shiftsTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "Shifts")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'shiftId', width: '5%' },
                    {
                        data: 'shiftCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'shiftNameAr' },
                    { data: 'shiftTypeNameAr' },
                    {
                        data: null,
                        render: function (row) {
                            return `<span class="badge bg-dark border border-secondary text-info">${row.startTime} - ${row.endTime}</span>`;
                        }
                    },
                    { data: 'standardHours', render: data => data ? `${data} hrs` : '-' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'shiftId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editShift(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#shiftId').val(0);
            $('#shiftForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#allowLateDeduction').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            shiftModal.show();
        }

        function editShift(id) {
            $.get('@Url.Action("GetById", "Shifts")/' + id, function (data) {
                if (data) {
                    $('#shiftId').val(data.shiftId);
                    $('#shiftTypeId').val(data.shiftTypeId);
                    $('#shiftCode').val(data.shiftCode);
                    $('#shiftNameAr').val(data.shiftNameAr);
                    $('#shiftNameEn').val(data.shiftNameEn);
                    $('#startTime').val(data.startTime);
                    $('#endTime').val(data.endTime);
                    $('#standardHours').val(data.standardHours);
                    $('#graceInMinutes').val(data.graceInMinutes);
                    $('#graceOutMinutes').val(data.graceOutMinutes);
                    $('#minimumOvertimeMinutes').val(data.minimumOvertimeMinutes);

                    $('#crossMidnight').prop('checked', data.crossMidnight);
                    $('#allowOvertime').prop('checked', data.allowOvertime);
                    $('#allowLateDeduction').prop('checked', data.allowLateDeduction);
                    $('#autoCloseAttendance').prop('checked', data.autoCloseAttendance);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    shiftModal.show();
                }
            });
        }

        function saveShift() {
            // تنسيق صيغة الوقت إلى HH:mm:ss لتقبلها TimeOnly
            let rawStartTime = $('#startTime').val();
            let rawEndTime = $('#endTime').val();

            let formattedStartTime = rawStartTime ? (rawStartTime.length === 5 ? rawStartTime + ':00' : rawStartTime) : null;
            let formattedEndTime = rawEndTime ? (rawEndTime.length === 5 ? rawEndTime + ':00' : rawEndTime) : null;

            let model = {
                ShiftId: parseInt($('#shiftId').val()) || 0,
                ShiftTypeId: parseInt($('#shiftTypeId').val()),
                ShiftCode: $('#shiftCode').val(),
                ShiftNameAr: $('#shiftNameAr').val(),
                ShiftNameEn: $('#shiftNameEn').val(),
                StartTime: formattedStartTime,
                EndTime: formattedEndTime,
                StandardHours: $('#standardHours').val() ? parseFloat($('#standardHours').val()) : null,
                GraceInMinutes: parseInt($('#graceInMinutes').val()) || 0,
                GraceOutMinutes: parseInt($('#graceOutMinutes').val()) || 0,
                MinimumOvertimeMinutes: parseInt($('#minimumOvertimeMinutes').val()) || 0,
                CrossMidnight: $('#crossMidnight').is(':checked'),
                AllowOvertime: $('#allowOvertime').is(':checked'),
                AllowLateDeduction: $('#allowLateDeduction').is(':checked'),
                AutoCloseAttendance: $('#autoCloseAttendance').is(':checked'),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.ShiftTypeId || !model.ShiftCode || !model.ShiftNameAr || !model.StartTime || !model.EndTime) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "Shifts")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        shiftModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}