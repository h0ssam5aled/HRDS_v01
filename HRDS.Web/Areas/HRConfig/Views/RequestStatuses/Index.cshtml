@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.RequestStatuses;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-tags fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.RequestStatuses</h4>
                    <p class="text-muted mb-0 small">@Resource.RequestStatusesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewStatus
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="requestStatusesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.StatusCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.BadgeStyle</th>
                            <th>@Resource.IsFinal</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="requestStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewStatus</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="requestStatusForm">
                    <input type="hidden" id="statusId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.StatusCode <span class="text-danger">*</span></label>
                        <input type="text" id="statusCode" class="form-control" placeholder="e.g. APPROVED" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="statusNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="statusNameEn" class="form-control" />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.BadgeClass</label>
                        <input type="text" id="badgeClass" class="form-control" placeholder="e.g. badge bg-success" />
                    </div>

                    <div class="d-flex gap-4 text-start">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isFinal">
                            <label class="form-check-label text-white ms-2" for="isFinal">@Resource.IsFinal</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isActive" checked>
                            <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveRequestStatus()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let requestStatusModal;

        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewStatus)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditStatus)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditStatus)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            yes: @Html.Raw(Json.Serialize(Resource.Yes)),
            no: @Html.Raw(Json.Serialize(Resource.No)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            requestStatusModal = new bootstrap.Modal(document.getElementById('requestStatusModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#requestStatusesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "RequestStatuses")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'statusId', width: '5%' },
                    {
                        data: 'statusCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'statusNameAr' },
                    { data: 'statusNameEn', render: data => data || '-' },
                    {
                        data: 'badgeClass',
                        render: function (data, type, row) {
                            let label = '@(currentCulture == "en" ? "Sample" : "معاينة")';
                            let cssClass = data || 'badge bg-secondary';
                            return `<span class="${cssClass}">${row.displayStatusName || label}</span>`;
                        }
                    },
                    {
                        data: 'isFinal',
                        render: function (data) {
                            return data ? `<span class="badge bg-danger">${localizedStrings.yes}</span>`
                                        : `<span class="badge bg-secondary">${localizedStrings.no}</span>`;
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'statusId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editRequestStatus(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#statusId').val(0);
            $('#requestStatusForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#isFinal').prop('checked', false);
            $('#modalTitle').html(localizedStrings.addTitle);
            requestStatusModal.show();
        }

        function editRequestStatus(id) {
            $.get('@Url.Action("GetById", "RequestStatuses")/' + id, function (data) {
                if (data) {
                    $('#statusId').val(data.statusId);
                    $('#statusCode').val(data.statusCode);
                    $('#statusNameAr').val(data.statusNameAr);
                    $('#statusNameEn').val(data.statusNameEn);
                    $('#badgeClass').val(data.badgeClass);
                    $('#isFinal').prop('checked', data.isFinal);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    requestStatusModal.show();
                }
            });
        }

        function saveRequestStatus() {
            let model = {
                StatusId: parseInt($('#statusId').val()) || 0,
                StatusCode: $('#statusCode').val(),
                StatusNameAr: $('#statusNameAr').val(),
                StatusNameEn: $('#statusNameEn').val(),
                BadgeClass: $('#badgeClass').val(),
                IsFinal: $('#isFinal').is(':checked'),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.StatusCode || !model.StatusNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "RequestStatuses")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        requestStatusModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}