@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.AllowanceTypes;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-cash-stack fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.AllowanceTypes</h4>
                    <p class="text-muted mb-0 small">@Resource.AllowanceTypesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewAllowanceType
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="allowanceTypesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.AllowanceTypeCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Description</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="allowanceTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewAllowanceType</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="allowanceTypeForm">
                    <input type="hidden" id="allowanceTypeId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.AllowanceTypeCode <span class="text-danger">*</span></label>
                        <input type="text" id="allowanceTypeCode" class="form-control" placeholder="e.g. HOUSING" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="allowanceTypeNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="allowanceTypeNameEn" class="form-control" />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Description</label>
                        <textarea id="description" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="form-check form-switch text-start">
                        <input class="form-check-input" type="checkbox" id="isActive" checked>
                        <label class="form-check-label text-white ms-2" for="isActive">@Resource.IsActive</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveAllowanceType()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let allowanceTypeModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewAllowanceType)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditAllowanceType)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditAllowanceType)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            allowanceTypeModal = new bootstrap.Modal(document.getElementById('allowanceTypeModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#allowanceTypesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "AllowanceTypes")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'allowanceTypeId', width: '5%' },
                    {
                        data: 'allowanceTypeCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'allowanceTypeNameAr' },
                    { data: 'allowanceTypeNameEn' },
                    { data: 'description', render: data => data || '-' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'allowanceTypeId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editAllowanceType(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#allowanceTypeId').val(0);
            $('#allowanceTypeForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            allowanceTypeModal.show();
        }

        function editAllowanceType(id) {
            $.get('@Url.Action("GetById", "AllowanceTypes")/' + id, function (data) {
                if (data) {
                    $('#allowanceTypeId').val(data.allowanceTypeId);
                    $('#allowanceTypeCode').val(data.allowanceTypeCode);
                    $('#allowanceTypeNameAr').val(data.allowanceTypeNameAr);
                    $('#allowanceTypeNameEn').val(data.allowanceTypeNameEn);
                    $('#description').val(data.description);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    allowanceTypeModal.show();
                }
            });
        }

        function saveAllowanceType() {
            let model = {
                AllowanceTypeId: parseInt($('#allowanceTypeId').val()) || 0,
                AllowanceTypeCode: $('#allowanceTypeCode').val(),
                AllowanceTypeNameAr: $('#allowanceTypeNameAr').val(),
                AllowanceTypeNameEn: $('#allowanceTypeNameEn').val(),
                Description: $('#description').val(),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.AllowanceTypeCode || !model.AllowanceTypeNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "AllowanceTypes")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        allowanceTypeModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}