@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.PaymentMethods;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-credit-card fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.PaymentMethods</h4>
                    <p class="text-muted mb-0 small">@Resource.PaymentMethodsDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewPaymentMethod
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="paymentMethodsTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.Code</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.Description</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentMethodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewPaymentMethod</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="paymentMethodForm">
                    <input type="hidden" id="paymentMethodId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Code <span class="text-danger">*</span></label>
                        <input type="text" id="paymentMethodCode" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="paymentMethodNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="paymentMethodNameEn" class="form-control" />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Description</label>
                        <textarea id="description" class="form-control" rows="2"></textarea>
                    </div>

                    <hr class="border-secondary my-3" />

                    <div class="form-check form-switch text-start">
                        <input class="form-check-input" type="checkbox" id="isActive" checked>
                        <label class="form-check-label text-white me-2" for="isActive">@Resource.IsActive</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="savePaymentMethod()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let paymentMethodModal;

        // تحويل الموارد إلى JSON صريح لتجنب مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewPaymentMethod)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditpaymentMethod)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive))
        };

        $(document).ready(function () {
            paymentMethodModal = new bootstrap.Modal(document.getElementById('paymentMethodModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#paymentMethodsTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "PaymentMethods")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'paymentMethodId', width: '5%' },
                    {
                        data: 'paymentMethodCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'paymentMethodNameAr' },
                    { data: 'paymentMethodNameEn', render: function (data) { return data || '-'; } },
                    { data: 'description', render: function (data) { return data || '-'; } },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'paymentMethodId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editPaymentMethod(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editTitle}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#paymentMethodId').val(0);
            $('#paymentMethodForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            paymentMethodModal.show();
        }

        function editPaymentMethod(id) {
            $.get('@Url.Action("GetById", "PaymentMethods")/' + id, function (data) {
                if (data) {
                    $('#paymentMethodId').val(data.paymentMethodId);
                    $('#paymentMethodCode').val(data.paymentMethodCode);
                    $('#paymentMethodNameAr').val(data.paymentMethodNameAr);
                    $('#paymentMethodNameEn').val(data.paymentMethodNameEn);
                    $('#description').val(data.description);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    paymentMethodModal.show();
                }
            });
        }

        function savePaymentMethod() {
            let model = {
                PaymentMethodId: parseInt($('#paymentMethodId').val()) || 0,
                PaymentMethodCode: $('#paymentMethodCode').val(),
                PaymentMethodNameAr: $('#paymentMethodNameAr').val(),
                PaymentMethodNameEn: $('#paymentMethodNameEn').val(),
                Description: $('#description').val(),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.PaymentMethodCode || !model.PaymentMethodNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "PaymentMethods")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        paymentMethodModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}