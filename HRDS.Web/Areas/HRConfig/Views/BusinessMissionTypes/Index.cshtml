@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.BusinessMissionTypes;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-briefcase fs-3 lh-1 flex-shrink-0 text-primary"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.BusinessMissionTypes</h4>
                    <p class="text-muted mb-0 small">@Resource.BusinessMissionTypesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewBusinessMissionType
            </button>
        </div>
    </div>

    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="missionTypesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.Code</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.HasAllowance</th>
                            <th>@Resource.Status</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="missionTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewBusinessMissionType</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="missionTypeForm">
                    <input type="hidden" id="missionTypeId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.Code <span class="text-danger">*</span></label>
                        <input type="text" id="missionTypeCode" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="missionTypeNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="missionTypeNameEn" class="form-control" />
                    </div>

                    <hr class="border-secondary my-3" />

                    <div class="row">
                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="hasAllowance">
                                <label class="form-check-label text-white me-2" for="hasAllowance">@Resource.HasAllowance</label>
                            </div>
                        </div>

                        <div class="col-md-6 mb-2 text-start">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label text-white me-2" for="isActive">@Resource.IsActive</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveMissionType()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let missionTypeModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewBusinessMissionType)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditBusinessMissionType)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditBusinessMissionType)),
            active: @Html.Raw(Json.Serialize(Resource.Active)),
            inactive: @Html.Raw(Json.Serialize(Resource.Inactive)),
            yes: @Html.Raw(Json.Serialize(Resource.Yes)),
            no: @Html.Raw(Json.Serialize(Resource.No)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            missionTypeModal = new bootstrap.Modal(document.getElementById('missionTypeModal'));
            loadDataTable();
        });

        function loadDataTable() {
            table = $('#missionTypesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "BusinessMissionTypes")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'missionTypeId', width: '5%' },
                    {
                        data: 'missionTypeCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'missionTypeNameAr' },
                    { data: 'missionTypeNameEn', render: function (data) { return data || '-'; } },
                    {
                        data: 'hasAllowance',
                        render: function (data) {
                            return data ? `<span class="badge bg-success">${localizedStrings.yes}</span>` : `<span class="badge bg-secondary">${localizedStrings.no}</span>`;
                        }
                    },
                    {
                        data: 'isActive',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-info">${localizedStrings.active}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.inactive}</span>`;
                        }
                    },
                    {
                        data: 'missionTypeId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editMissionType(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#missionTypeId').val(0);
            $('#missionTypeForm')[0].reset();
            $('#isActive').prop('checked', true);
            $('#modalTitle').html(localizedStrings.addTitle);
            missionTypeModal.show();
        }

        function editMissionType(id) {
            $.get('@Url.Action("GetById", "BusinessMissionTypes")/' + id, function (data) {
                if (data) {
                    $('#missionTypeId').val(data.missionTypeId);
                    $('#missionTypeCode').val(data.missionTypeCode);
                    $('#missionTypeNameAr').val(data.missionTypeNameAr);
                    $('#missionTypeNameEn').val(data.missionTypeNameEn);
                    $('#hasAllowance').prop('checked', data.hasAllowance);
                    $('#isActive').prop('checked', data.isActive);

                    $('#modalTitle').html(localizedStrings.editTitle);
                    missionTypeModal.show();
                }
            });
        }

        function saveMissionType() {
            let model = {
                MissionTypeId: parseInt($('#missionTypeId').val()) || 0,
                MissionTypeCode: $('#missionTypeCode').val(),
                MissionTypeNameAr: $('#missionTypeNameAr').val(),
                MissionTypeNameEn: $('#missionTypeNameEn').val(),
                HasAllowance: $('#hasAllowance').is(':checked'),
                IsActive: $('#isActive').is(':checked')
            };

            if (!model.MissionTypeCode || !model.MissionTypeNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "BusinessMissionTypes")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        missionTypeModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}