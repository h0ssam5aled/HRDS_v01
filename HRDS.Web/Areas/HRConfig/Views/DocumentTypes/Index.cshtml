@using HRDS.Web.Resources
@using System.Globalization

@{
    ViewData["Title"] = Resource.DocumentTypes;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToLower();
    var isRtl = currentCulture == "ar";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-3" lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Header Card -->
    <div class="card dark-card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-file-earmark-text fs-3 lh-1 flex-shrink-0 text-info"></i>
                <div class="d-flex flex-column align-items-start text-start">
                    <h4 class="mb-1 fw-bold">@Resource.DocumentTypes</h4>
                    <p class="text-muted mb-0 small">@Resource.DocumentTypesDescription</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary px-3 py-2" onclick="openAddModal()">
                <i class="bi bi-plus-lg me-1"></i> @Resource.AddNewDocumentType
            </button>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card dark-card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="documentTypesTable" class="table align-middle w-100 m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@Resource.TypeCode</th>
                            <th>@Resource.ArabicName</th>
                            <th>@Resource.EnglishName</th>
                            <th>@Resource.IsExpiryRequired</th>
                            <th>@Resource.ExpiryAlertDays</th>
                            <th>@Resource.IsMandatory</th>
                            <th>@Resource.Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal الإضافة والتعديل -->
<div class="modal fade" id="documentTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="modalTitle">@Resource.AddNewDocumentType</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="documentTypeForm">
                    <input type="hidden" id="documentTypeId" value="0" />

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.TypeCode <span class="text-danger">*</span></label>
                        <input type="text" id="typeCode" class="form-control" placeholder="e.g. PASSPORT" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.ArabicName <span class="text-danger">*</span></label>
                        <input type="text" id="typeNameAr" class="form-control" required />
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label text-white">@Resource.EnglishName</label>
                        <input type="text" id="typeNameEn" class="form-control" />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 text-start">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="isExpiryRequired" onchange="toggleExpiryDays()">
                                <label class="form-check-input-label text-white ms-2" for="isExpiryRequired">@Resource.IsExpiryRequired</label>
                            </div>
                        </div>
                        <div class="col-md-6 text-start">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="isMandatory">
                                <label class="form-check-input-label text-white ms-2" for="isMandatory">@Resource.IsMandatory</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 text-start" id="expiryDaysContainer" style="display: none;">
                        <label class="form-label text-white">@Resource.ExpiryAlertDays</label>
                        <input type="number" id="expiryAlertDays" class="form-control" placeholder="30" min="1" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Resource.Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveDocumentType()">
                    <i class="bi bi-save me-1"></i> @Resource.SaveData
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let table;
        let documentTypeModal;

        // تحويل الموارد والنصوص إلى JSON صريح لمنع مشكلة الـ HTML Encoding
        const localizedStrings = {
            addTitle: @Html.Raw(Json.Serialize(Resource.AddNewDocumentType)),
            editTitle: @Html.Raw(Json.Serialize(Resource.EditDocumentType)),
            editBtn: @Html.Raw(Json.Serialize(Resource.EditDocumentType)),
            yes: @Html.Raw(Json.Serialize(Resource.Yes)),
            no: @Html.Raw(Json.Serialize(Resource.No)),
            mandatory: @Html.Raw(Json.Serialize(Resource.Mandatory)),
            optional: @Html.Raw(Json.Serialize(Resource.Optional)),
            days: @Html.Raw(Json.Serialize(Resource.Days)),
            requiredError: @Html.Raw(Json.Serialize(Resource.RequiredFieldsErrorMessage)),
            saveError: @Html.Raw(Json.Serialize(Resource.SaveErrorMessage))
        };

        $(document).ready(function () {
            documentTypeModal = new bootstrap.Modal(document.getElementById('documentTypeModal'));
            loadDataTable();
        });

        function toggleExpiryDays() {
            if ($('#isExpiryRequired').is(':checked')) {
                $('#expiryDaysContainer').slideDown();
            } else {
                $('#expiryDaysContainer').slideUp();
                $('#expiryAlertDays').val('');
            }
        }

        function loadDataTable() {
            let isRtl = @(isRtl.ToString().ToLower());

            table = $('#documentTypesTable').DataTable({
                pagingType: 'simple',
                ajax: {
                    url: '@Url.Action("GetJson", "DocumentTypes")',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'documentTypeId', width: '5%' },
                    {
                        data: 'typeCode',
                        render: function (data) {
                            return `<span class="badge dark-badge-code font-monospace px-2 py-1">${data || ''}</span>`;
                        }
                    },
                    { data: 'typeNameAr' },
                    { data: 'typeNameEn' },
                    {
                        data: 'isExpiryRequired',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-warning"><i class="bi bi-clock me-1"></i>${localizedStrings.yes}</span>`
                                        : `<span class="badge neon-badge-muted">${localizedStrings.no}</span>`;
                        }
                    },
                    {
                        data: 'expiryAlertDays',
                        render: function (data) {
                            if (!data) return '-';
                            return isRtl ? `${localizedStrings.days} ${data}` : `${data} ${localizedStrings.days}`;
                        }
                    },
                    {
                        data: 'isMandatory',
                        render: function (data) {
                            return data ? `<span class="badge neon-badge-danger">${localizedStrings.mandatory}</span>`
                                        : `<span class="badge neon-badge-info">${localizedStrings.optional}</span>`;
                        }
                    },
                    {
                        data: 'documentTypeId',
                        render: function (data) {
                            return `<button class="btn btn-sm btn-action-edit" onclick="editDocumentType(${data})">
                                        <i class="bi bi-pencil-square me-1"></i>${localizedStrings.editBtn}
                                    </button>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/@(currentCulture == "ar" ? "ar.json" : "en-GB.json")'
                }
            });
        }

        function openAddModal() {
            $('#documentTypeId').val(0);
            $('#documentTypeForm')[0].reset();
            toggleExpiryDays();
            $('#modalTitle').html(localizedStrings.addTitle);
            documentTypeModal.show();
        }

        function editDocumentType(id) {
            $.get('@Url.Action("GetById", "DocumentTypes")/' + id, function (data) {
                if (data) {
                    $('#documentTypeId').val(data.documentTypeId);
                    $('#typeCode').val(data.typeCode);
                    $('#typeNameAr').val(data.typeNameAr);
                    $('#typeNameEn').val(data.typeNameEn);
                    $('#isExpiryRequired').prop('checked', data.isExpiryRequired);
                    $('#expiryAlertDays').val(data.expiryAlertDays);
                    $('#isMandatory').prop('checked', data.isMandatory);

                    toggleExpiryDays();
                    $('#modalTitle').html(localizedStrings.editTitle);
                    documentTypeModal.show();
                }
            });
        }

        function saveDocumentType() {
            let isExpiry = $('#isExpiryRequired').is(':checked');
            let model = {
                DocumentTypeId: parseInt($('#documentTypeId').val()) || 0,
                TypeCode: $('#typeCode').val(),
                TypeNameAr: $('#typeNameAr').val(),
                TypeNameEn: $('#typeNameEn').val(),
                IsExpiryRequired: isExpiry,
                ExpiryAlertDays: isExpiry && $('#expiryAlertDays').val() ? parseInt($('#expiryAlertDays').val()) : null,
                IsMandatory: $('#isMandatory').is(':checked')
            };

            if (!model.TypeCode || !model.TypeNameAr) {
                alert(localizedStrings.requiredError);
                return;
            }

            let token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("Save", "DocumentTypes")',
                type: 'POST',
                contentType: 'application/json',
                headers: { "RequestVerificationToken": token },
                data: JSON.stringify(model),
                success: function (response) {
                    if (response.success) {
                        documentTypeModal.hide();
                        table.ajax.reload(null, false);
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert(localizedStrings.saveError);
                }
            });
        }
    </script>
}