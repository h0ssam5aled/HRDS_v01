@model HRDS.Web.Models.SidebarMenuViewModel

<aside class="erp-sidebar" id="sidebar">
    <div class="sidebar-scroll-area">
        <div class="accordion accordion-flush" id="sidebarMenu">
            @if (Model.Modules != null && Model.Modules.Any())
            {
                int index = 1;
                foreach (var module in Model.Modules)
                {
                    var collapseId = $"m_{module.ModuleId}";
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                <i class="@module.IconClass me-2"></i> @module.ModuleName
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#sidebarMenu">
                            <div class="accordion-body">
                                @foreach (var pageModel in module.Models)
                                {
                                    <a class="sub-menu-link" href="@pageModel.Url">
                                        <i class="bi bi-circle"></i>@pageModel.ModelName
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                    index++;
                }
            }
        </div>
    </div>
</aside>