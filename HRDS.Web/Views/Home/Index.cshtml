@model HRDS.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "الرئيسية";
}

<!-- Grid Tiles -->
<div class="row g-3">
    @if (Model?.AllowedModules != null && Model.AllowedModules.Any())
    {
        @foreach (var module in Model.AllowedModules)
        {
            <div class="col-12 col-sm-6 col-xl-3">
                <a href="@module.Url" class="fiori-tile">
                    <div>
                        <div class="fiori-tile-icon" style="color: @module.Color; background-color: rgba(255,255,255,0.05);">
                            <i class="@module.IconClass"></i>
                        </div>
                        <h6 class="tile-title">@module.Title</h6>
                        <p class="tile-desc">@module.Description</p>
                    </div>
                    <div class="mt-3 pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center fs-7 fw-bold" style="color: @module.Color;">
                        <span>@module.ActionText</span>
                        <i class="bi bi-arrow-left"></i>
                    </div>
                </a>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="p-4 rounded-3 empty-state-box">
                <i class="bi bi-shield-lock fs-1 text-warning mb-2 d-block"></i>
                <h6 class="text-white fw-bold">لا توجد وحدات متاحة لحسابك حالياً</h6>
                <p class="text-sub fs-7 m-0">تواصل مع مسؤول النظام لإضافة الصلاحيات المناسبة لدورك الوظيفي.</p>
            </div>
        </div>
    }
</div>